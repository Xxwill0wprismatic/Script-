-- PLAYER LIST
local function buildPlayerList(tabName, actionLabel, actionCb)
    local tab = Tabs[tabName]
    if not tab then return end
    local sbY = tab.ypos
    tab.ypos = tab.ypos + 26
    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -8, 0, 22)
    searchBox.Position = UDim2.new(0, 4, 0, sbY)
    searchBox.BackgroundColor3 = BLACK
    searchBox.BorderSizePixel = 0
    searchBox.PlaceholderText = "Search players..."
    searchBox.Text = ""
    searchBox.TextColor3 = PURPLE_LT
    searchBox.PlaceholderColor3 = MUTED
    searchBox.Font = Enum.Font.GothamBold
    searchBox.TextSize = 11
    searchBox.ClearTextOnFocus = false
    searchBox.ZIndex = 15
    searchBox.Parent = tab.page
    Instance.new("UICorner", searchBox).CornerRadius = UDim.new(0, 5)
    Instance.new("UIStroke", searchBox).Color = PURPLE
    local listY = tab.ypos
    tab.ypos = tab.ypos + 200
    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(1, -8, 0, 200)
    list.Position = UDim2.new(0, 4, 0, listY)
    list.BackgroundColor3 = BLACK
    list.BorderSizePixel = 0
    list.ScrollBarThickness = 3
    list.ScrollBarImageColor3 = PURPLE
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.ZIndex = 15
    list.Parent = tab.page
    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
    local entries = {}
    local function refresh()
        for _, e in ipairs(entries) do
            if e.button and e.button.Parent then e.button:Destroy() end
        end
        entries = {}
        local q = searchBox.Text:lower()
        local y = 4
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and (q == "" or p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true)) then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -8, 0, 22)
                btn.Position = UDim2.new(0, 4, 0, y)
                btn.BackgroundColor3 = BLACK2
                btn.BorderSizePixel = 0
                btn.Text = p.Name .. " (" .. actionLabel .. ")"
                btn.TextColor3 = PURPLE_LT
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 10
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.AutoButtonColor = false
                btn.ZIndex = 16
                btn.Parent = list
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
                btn.MouseButton1Click:Connect(function()
                    local ok, err = pcall(actionCb, p)
                    if not ok then logErr(actionLabel .. " failed: " .. tostring(err)) end
                end)
                table.insert(entries, {button=btn, player=p})
                y = y + 24
            end
        end
        list.CanvasSize = UDim2.new(0, 0, 0, y + 4)
    end
    searchBox:GetPropertyChangedSignal("Text"):Connect(refresh)
    Players.PlayerAdded:Connect(function()
        task.wait(0.3)
        refresh()
    end)
    Players.PlayerRemoving:Connect(function()
        task.wait(0.1)
        refresh()
    end)
    refresh()
end

