local function makeGui(name, order)
    local s = Instance.new("ScreenGui")
    s.Name = name
    s.ResetOnSpawn = false
    s.IgnoreGuiInset = true
    s.DisplayOrder = order or 999
    if gethui then pcall(function() s.Parent = gethui() end) end
    if not s.Parent then pcall(function() s.Parent = game:GetService("CoreGui") end) end
    if not s.Parent then s.Parent = pg end
    if not s.Parent then error("[BH] cannot parent " .. name) end
    return s
end

