-- TROLL: FLING PLAYER
-- ==========================================================
local flingBusy = {}
local function flingPlayer(plr)
    if not plr or plr == LP then return false end
    if flingBusy[plr] then return false end
    flingBusy[plr] = true

    local myChar = LP.Character
    if not myChar then
        flingBusy[plr] = false
        return false
    end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not (myHRP and myHum) then
        flingBusy[plr] = false
        return false
    end

    local tChar = plr.Character
    if not tChar then
        flingBusy[plr] = false
        return false
    end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar:FindFirstChildOfClass("Humanoid")
    if not tHRP then
        flingBusy[plr] = false
        return false
    end
    if tHum and tHum.Health <= 0 then
        flingBusy[plr] = false
        return false
    end

    pcall(function() myHRP:SetNetworkOwner(LP) end)
    pcall(function() myHum.PlatformStand = true end)
    pcall(function() myHum:ChangeState(Enum.HumanoidStateType.Physics) end)

    pcall(function()
        for _, o in ipairs(myChar:GetChildren()) do
            if o:IsA("Accessory") or o:IsA("Hat") then
                o:Destroy()
            end
        end
    end)

    myHRP.AssemblyLinearVelocity = Vector3.zero
    myHRP.AssemblyAngularVelocity = Vector3.zero
    pcall(function()
        myHRP.CFrame = tHRP.CFrame
    end)
    task.wait(0.05)

    if not (myHRP.Parent and tHRP.Parent) then
        flingBusy[plr] = false
        if myHum and myHum.Parent then
            pcall(function() myHum.PlatformStand = false end)
        end
        return false
    end

    local skid = Instance.new("Part")
    skid.Name = "BH_FlingSpin"
    skid.Size = Vector3.new(100, 100, 100)
    skid.Transparency = 1
    skid.CanCollide = false
    skid.CanQuery = false
    skid.CanTouch = false
    skid.Massless = false
    skid.CFrame = myHRP.CFrame
    skid.Parent = Workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = myHRP
    weld.Part1 = skid
    weld.Parent = skid

    pcall(function()
        skid.RotVelocity = Vector3.new(9999, 9999, 9999)
    end)

    pcall(function()
        myHRP.AssemblyLinearVelocity = Vector3.new(
            math.random(-10, 10),
            3,
            math.random(-10, 10)
        )
    end)

    task.wait(0.15)

    if weld and weld.Parent then pcall(function() weld:Destroy() end) end
    if skid and skid.Parent then pcall(function() skid:Destroy() end) end

    if myHRP and myHRP.Parent then
        pcall(function()
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
            myHRP.Velocity = Vector3.zero
            myHRP.RotVelocity = Vector3.zero
            myHRP.CFrame = myHRP.CFrame + Vector3.new(0, 6, 0)
        end)
    end
    task.wait(0.05)
    if myHum and myHum.Parent then
        pcall(function()
            myHum.PlatformStand = false
            myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    flingBusy[plr] = false
    return true
end

-- FLING SELF
local selfSpinActive = false
local selfSpinThread = nil
local function startFlingSelf()
    if selfSpinActive then return end
    selfSpinActive = true
    selfSpinThread = task.spawn(function()
        while selfSpinActive and sg.Parent do
            local ch = LP.Character
            local h = ch and ch:FindFirstChild("HumanoidRootPart")
            if h then
                pcall(function()
                    local spin = Instance.new("Part")
                    spin.Name = "BH_SelfSpin"
                    spin.Size = Vector3.new(4, 4, 4)
                    spin.Transparency = 1
                    spin.CanCollide = false
                    spin.CanQuery = false
                    spin.CanTouch = false
                    spin.Massless = true
                    spin.CFrame = h.CFrame
                    spin.Parent = Workspace
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = h
                    weld.Part1 = spin
                    weld.Parent = spin
                    local av = Instance.new("BodyAngularVelocity")
                    av.AngularVelocity = Vector3.new(2000, 2000, 2000)
                    av.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                    av.P = 5e4
                    av.Parent = spin
                    task.delay(1.0, function()
                        pcall(function() av:Destroy() end)
                        pcall(function() weld:Destroy() end)
                        pcall(function() spin:Destroy() end)
                    end)
                end)
            end
            task.wait(1.5)
        end
        selfSpinActive = false
    end)
end
local function stopFlingSelf()
    selfSpinActive = false
    if selfSpinThread then
        pcall(task.cancel, selfSpinThread)
        selfSpinThread = nil
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "BH_SelfSpin" then
            pcall(function() v:Destroy() end)
        end
    end
end

-- TOUCH FLING: disabled, coming soon.
local touchFlingRunning = false
local touchFlingThread = nil
local touchFlingCd = {}
local function startTouchFling()
    if touchFlingRunning then return end
    touchFlingRunning = true
    touchFlingThread = task.spawn(function()
        while touchFlingRunning and sg.Parent do
            local myChar = LP.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character and alive(p) then
                        local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP then
                            local dist = (myHRP.Position - tHRP.Position).Magnitude
                            if dist <= 6 then
                                local now = tick()
                                if not touchFlingCd[p] or now - touchFlingCd[p] > 2.5 then
                                    touchFlingCd[p] = now
                                    task.spawn(function()
                                        pcall(flingPlayer, p)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.15)
        end
        touchFlingRunning = false
    end)
end
local function stopTouchFling()
    touchFlingRunning = false
    if touchFlingThread then
        pcall(task.cancel, touchFlingThread)
        touchFlingThread = nil
    end
    touchFlingCd = {}
end

