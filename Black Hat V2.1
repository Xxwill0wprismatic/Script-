RunService.RenderStepped:Connect(function()
    local espOn = Cfg.ESPPlayers
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            if espOn then
                if not playerTags[p] then
                    playerTags[p] = buildESPFor(p)
                end
