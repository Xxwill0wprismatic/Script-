    grip.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            rs = {sx=i.Position.X, sy=i.Position.Y, w=Main.AbsoluteSize.X, h=Main.AbsoluteSize.Y}
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not rs then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            local nW = math.clamp(rs.w + (i.Position.X - rs.sx), MIN_W, MAX_W)
            local nH = math.clamp(rs.h + (i.Position.Y - rs.sy), MIN_H, MAX_H)
            Main.Size = UDim2.new(0, nW, 0, nH)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if not rs then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then rs = nil end
    end)
end

