local nth
local function notify(t)
    nl.Text = t
    nf.Visible = true
    nf.BackgroundTransparency = 0
    if nth then
        pcall(task.cancel, nth)
        nth = nil
    end
    nth = task.delay(2, function()
        if nf and nf.Parent then
            pcall(function()
                TweenService:Create(nf, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
            end)
            task.wait(0.35)
            if nf and nf.Parent then
                nf.Visible = false
                nf.BackgroundTransparency = 0
            end
        end
        nth = nil
    end)
end
