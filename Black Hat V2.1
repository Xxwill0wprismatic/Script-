                teardownESP(p)
            else
                local head = c:FindFirstChild("Head")
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")
                if not (head and hum and hum.Health > 0) then
                    if t.bg then t.bg.Enabled = false end
                    if t.box then t.box.Visible = false end
                else
                    if t.bg then t.bg.Enabled = true end
                    if t.name then
                        t.name.Visible = Cfg.ESPName
                        t.name.Text = p.Name
                    end
                    if t.dist then
                        t.dist.Visible = Cfg.ESPDistance
                        if myHrp and root then
                            local d = math.floor((myHrp.Position - root.Position).Magnitude)
                            t.dist.Text = d .. "m"
                        end
                    end
                    if t.hpBg then t.hpBg.Visible = Cfg.ESPHealth end
                    if t.hpFill then
                        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        t.hpFill.Size = UDim2.new(pct, 0, 1, 0)
                        t.hpFill.BackgroundColor3 = pct > 0.6 and GREEN or pct > 0.3 and GOLD or RED
                    end
                    if t.box then
                        if Cfg.ESPBox and root then
                            local top = head.Position + Vector3.new(0, 1.2, 0)
                            local bot = root.Position - Vector3.new(0, 2.5, 0)
                            local ts, tOn = cc:WorldToViewportPoint(top)
                            local bs, bOn = cc:WorldToViewportPoint(bot)
                            if tOn and bOn then
                                local topY = math.min(ts.Y, bs.Y)
                                local botY = math.max(ts.Y, bs.Y)
                                local midX = (ts.X + bs.X) / 2
                                local h = botY - topY
