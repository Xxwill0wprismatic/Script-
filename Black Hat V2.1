        if not h then return end
        if Cfg.Fly then
            if u then u.PlatformStand = true end
            local c = cam()
            local bv = h:FindFirstChild("BH_Fly")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "BH_Fly"
                bv.MaxForce = Vector3.new(1e5,1e5,1e5)
                bv.P = 1250
                bv.Parent = h
            end
            local bg = h:FindFirstChild("BH_Gyro")
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "BH_Gyro"
                bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
                bg.P = 5000
                bg.D = 500
                bg.Parent = h
            end
            local md = Vector3.zero
            if c then
                if UIS:IsKeyDown(Enum.KeyCode.W) then md = md + c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then md = md - c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then md = md - c.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then md = md + c.CFrame.RightVector end
            end
            if md.Magnitude < 0.05 and u and u.MoveDirection.Magnitude > 0.05 then
                md = u.MoveDirection
            end
            if md.Magnitude > 1 then md = md.Unit end
            local v = 0
            if UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + 1 end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v = v - 1 end
            if Cfg.FlyUpBtn then v = v + 1 end
            if Cfg.FlyDownBtn then v = v - 1 end
            bv.Velocity = (md * Cfg.FlySpeed) + Vector3.new(0, v * Cfg.FlyVertical, 0)
            if c then bg.CFrame = c.CFrame end
        else
            local u2 = ch:FindFirstChildOfClass("Humanoid")
            if u2 then u2.PlatformStand = false end
            local bv = h:FindFirstChild("BH_Fly")
            if bv then bv:Destroy() end
            local bg = h:FindFirstChild("BH_Gyro")
            if bg then bg:Destroy() end
        end
    end)
end)
