-- FEATURES
local featureOK, featureErr = xpcall(function()

local function nearestPlayer(range)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local th = p.Character:FindFirstChild("HumanoidRootPart")
            if th then
                local d = (th.Position - hrp.Position).Magnitude
                if d < bd and d <= range then
                    bd = d
                    best = p
                end
            end
        end
    end
    return best
end

local function selectPart(ch)
    if Cfg.AimPart == "Head" then
        return ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    end
    if Cfg.AimPart == "Torso" then
        return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart")
    end
    return ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
end

local function predictPos(part)
    if not Cfg.AimbotPrediction or Cfg.AimbotPrediction <= 0 then
        return part.Position
    end
    return part.Position + (part.AssemblyLinearVelocity or Vector3.zero) * Cfg.AimbotPrediction
end

local function hasLOS(targetChar)
    local myHead = LP.Character and LP.Character:FindFirstChild("Head")
    if not myHead then return false end
    local targetPart = selectPart(targetChar)
    if not targetPart then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character}
    rp.IgnoreWater = true
    local dir = targetPart.Position - myHead.Position
    local res = Workspace:Raycast(myHead.Position, dir, rp)
    if res then
        return res.Instance and res.Instance:IsDescendantOf(targetChar)
    end
    return true
end

-- ==========================================================
-- AIMBOT (rewritten from scratch — does NOT touch CameraType or
-- CameraSubject. Only writes Camera.CFrame rotation at Camera
-- priority + 1 so it runs AFTER the default camera module).
-- ==========================================================
local AIMBOT_BIND = "BH_AimbotCamera"
pcall(function() RunService:UnbindFromRenderStep(AIMBOT_BIND) end)

RunService:BindToRenderStep(AIMBOT_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not (Cfg.AimbotEnabled or Cfg.AimAssist) then return end
    if Cfg.AimbotHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    if Cfg.SilentAim then return end
    if Cfg.Freecam then return end

    local ok, err = pcall(function()
        local c = cam()
        if not c then return end
        local cp = c.CFrame.Position
        local sc = Vector2.new(c.ViewportSize.X/2, c.ViewportSize.Y/2)
        local best, bd = nil, math.huge

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and alive(p) then
                if not (Cfg.TeamCheck and p.Team ~= nil and p.Team == LP.Team) then
                    local part = selectPart(p.Character)
                    if part then
                        local d = (part.Position - cp).Magnitude
                        if d <= Cfg.MaxDistance then
                            if not Cfg.WallCheck or hasLOS(p.Character) then
                                local sp, on = c:WorldToViewportPoint(part.Position)
                                if on then
                                    local ang = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                                    if ang <= Cfg.FOV and ang < bd then
                                        bd = ang
                                        best = p
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if not best or not best.Character then return end
        local part = selectPart(best.Character)
        if not part then return end

        local tp = predictPos(part)
        local cur = c.CFrame
        local want = CFrame.new(cur.Position, tp)
        local a
        if Cfg.AimAssist then
            a = 0.15
        else
            a = 1 - (Cfg.AimbotSmooth / 100)
        end

        if a >= 1 then
            c.CFrame = want
        elseif a > 0 then
            local nl = cur.LookVector:Lerp(want.LookVector, a)
            if nl.Magnitude > 0.001 then
                c.CFrame = CFrame.new(cur.Position, cur.Position + nl.Unit)
            end
        end
    end)
    if not ok then logErr("Aimbot: " .. tostring(err)) end
end)

registerCleanup(function()
    pcall(function() RunService:UnbindFromRenderStep(AIMBOT_BIND) end)
end)

