RunService.RenderStepped:Connect(function()
    local activeKeys = {}
    if Cfg.ESPTracer then
        pcall(function()
            local c = cam()
            if not c then return end
            local vp = c.ViewportSize
            local originX = vp.X * 0.5
            local originY = vp.Y - 2
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local hr = p.Character:FindFirstChild("HumanoidRootPart")
                    local u = p.Character:FindFirstChildOfClass("Humanoid")
                    if hr and u and u.Health > 0 then
                        local sp, on = c:WorldToViewportPoint(hr.Position)
                        if on then
                            local key = "tr_" .. p.UserId
                            activeKeys[key] = true
                            local line = tracerHolder:FindFirstChild(key)
                            if not line then
                                line = Instance.new("Frame")
                                line.Name = key
                                line.BackgroundColor3 = PURPLE_LT
                                line.BorderSizePixel = 0
                                line.AnchorPoint = Vector2.new(0, 0.5)
                                line.ZIndex = 6
                                line.Parent = tracerHolder
                            end
                            local dx = sp.X - originX
                            local dy = sp.Y - originY
                            local len = math.sqrt(dx * dx + dy * dy)
                            if len > 0.5 then
                                line.Size = UDim2.fromOffset(len, 1)
                                line.Position = UDim2.fromOffset(originX, originY)
                                line.Rotation = math.deg(math.atan2(dy, dx))
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        end
                    end
                end
            end
        end)
    end
    for _, child in ipairs(tracerHolder:GetChildren()) do
        if not activeKeys[child.Name] then
            child:Destroy()
        end
    end
end)

