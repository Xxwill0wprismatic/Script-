-- DRAG
do
    local ds, dp
    local function bd(i)
        ds = true
        dp = {px = i.Position.X, py = i.Position.Y, ax = Main.AbsolutePosition.X, ay = Main.AbsolutePosition.Y}
    end
    local function ud(i)
        if not ds or not dp then return end
        Main.Position = UDim2.new(0, dp.ax + (i.Position.X - dp.px), 0, dp.ay + (i.Position.Y - dp.py))
    end
    Header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then bd(i) end
    end)
    HT.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then bd(i) end
    end)
    Main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            local clickedButton = false
            for _, child in ipairs(Main:GetDescendants()) do
                if child:IsA("TextButton") or child:IsA("ImageButton") or child:IsA("TextBox") then
                    local p = child.AbsolutePosition
                    local s = child.AbsoluteSize
                    if i.Position.X >= p.X and i.Position.X <= p.X + s.X and i.Position.Y >= p.Y and i.Position.Y <= p.Y + s.Y then
                        clickedButton = true
                        break
                    end
                end
            end
            if not clickedButton then bd(i) end
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not ds then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then ud(i) end
    end)
    UIS.InputEnded:Connect(function(i)
        if not ds then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then ds, dp = nil, nil end
    end)
end

