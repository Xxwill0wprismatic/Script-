        if Cfg.Noclip then
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.CanQuery = false
                end
            end
        end
        if u and not Cfg.Fly then
            local base = Cfg.SpeedHack and Cfg.SpeedValue or 16
            if Cfg.SpeedKey and UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                base = base * Cfg.SpeedKeyMul
            end
            u.WalkSpeed = base
        end
        if Cfg.JumpBoost and u then
            u.UseJumpPower = true
            u.JumpPower = Cfg.JumpPower
        end
        if Cfg.JumpKey and u and UIS:IsKeyDown(Enum.KeyCode.LeftAlt) then
            u.UseJumpPower = true
            u.JumpPower = 250
        end
        if h then h.Anchored = Cfg.FreezeSelf end
        if Cfg.AutoGround and h then
            local ray = RaycastParams.new()
            ray.FilterType = Enum.RaycastFilterType.Exclude
            ray.FilterDescendantsInstances = {ch}
            local res = Workspace:Raycast(h.Position, Vector3.new(0, -10, 0), ray)
            if res and (h.Position - res.Position).Magnitude > 5 then
                h.CFrame = CFrame.new(res.Position + Vector3.new(0, 3, 0))
            end
        end
    end)
end)
