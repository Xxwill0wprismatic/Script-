    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.ZIndex = 15
    list.Parent = tab.page
    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
    local entries = {}
