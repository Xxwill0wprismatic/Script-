-- AUTO CLICKER
-- ==========================================================
local AUTO_CLICK_MAX_PER_FRAME = 50
local autoClickAccum = 0
local autoClickerErrored = false
local acBtnRefresh = nil
local clickMarker = nil
do
    local m = Instance.new("Frame")
    m.Name = "BH_ClickMarker"
    m.Size = UDim2.new(0, 26, 0, 26)
    m.AnchorPoint = Vector2.new(0.5, 0.5)
    m.BackgroundTransparency = 1
    m.Visible = false
    m.ZIndex = 4000
    m.Parent = sg
    local s = Instance.new("UIStroke", m)
    s.Color = Color3.fromRGB(255, 80, 80)
    s.Thickness = 2
    local c = Instance.new("UICorner", m)
    c.CornerRadius = UDim.new(1, 0)
    clickMarker = m
end
local function showMarker(pos)
    if not clickMarker or not clickMarker.Parent then return end
    clickMarker.Position = UDim2.new(0, pos.X, 0, pos.Y)
    clickMarker.Visible = true
    clickMarker.Size = UDim2.new(0, 26, 0, 26)
    TweenService:Create(clickMarker, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 12, 0, 12)
    }):Play()
end
local function hideMarker()
    if clickMarker then clickMarker.Visible = false end
end
local function doClick(pos)
    if syn and syn.mousemoveabs and syn.mouse1click then
        if pcall(function() syn.mousemoveabs(pos.X, pos.Y); syn.mouse1click() end) then return true end
    end
    if mousemoveabs and mouse1click then
        if pcall(function() mousemoveabs(pos.X, pos.Y); mouse1click() end) then return true end
    end
    if VU and VU.ClickButton1 then
        if pcall(function()
            if VU.CaptureController then pcall(function() VU:CaptureController() end) end
            VU:ClickButton1(pos)
        end) then return true end
    end
    if VU and VU.Button1Down and VU.Button1Up then
        if pcall(function()
            if VU.CaptureController then pcall(function() VU:CaptureController() end) end
            VU:Button1Down(pos)
            VU:Button1Up(pos)
        end) then return true end
    end
    if mouse1press and mouse1release then
        if pcall(function() mouse1press(); mouse1release() end) then return true end
    end
    if firesignal and LP.GetGuiObjectsAtPosition then
        local hit = false
        local ok = pcall(function()
            local objs = LP:GetGuiObjectsAtPosition(pos.X, pos.Y)
            for _, o in ipairs(objs) do
                if o:IsA("GuiButton") and o.Visible then
                    pcall(firesignal, o.MouseButton1Down)
                    pcall(firesignal, o.MouseButton1Up)
                    pcall(firesignal, o.MouseButton1Click)
                    hit = true
                    break
                end
            end
        end)
        if ok and hit then return true end
    end
    return false
end
RunService.Heartbeat:Connect(function(dt)
    if not Cfg.AutoClicker or not Cfg.AutoClickPoint then
        autoClickAccum = 0
        autoClickerErrored = false
        return
    end
    if autoClickerErrored then return end
    local cps = math.clamp(tonumber(Cfg.AutoClickerCPS) or 10, 1, 200)
    local interval = 1 / cps
    autoClickAccum = autoClickAccum + dt
    local fired = 0
    while autoClickAccum >= interval and fired < AUTO_CLICK_MAX_PER_FRAME do
        autoClickAccum = autoClickAccum - interval
        fired = fired + 1
        local ok = doClick(Cfg.AutoClickPoint)
        if not ok then
            logErr("AutoClicker: no working click method on this executor")
            Cfg.AutoClicker = false
            Cfg.AutoClickPoint = nil
            Cfg.AutoClickerArmed = false
            autoClickAccum = 0
            autoClickerErrored = true
            hideMarker()
            if acBtnRefresh then acBtnRefresh() end
            break
        end
        showMarker(Cfg.AutoClickPoint)
    end
end)

-- FREECAM
local freecamConn = nil
local function setFreecam(on)
    local c = cam()
    if not c then return end
    if on then
        c.CameraType = Enum.CameraType.Scriptable
        if freecamConn then freecamConn:Disconnect() end
        freecamConn = RunService.RenderStepped:Connect(function(dt)
            if not Cfg.Freecam then return end
            local md = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then md = md + c.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then md = md - c.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then md = md - c.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then md = md + c.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then md = md + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then md = md + Vector3.new(0, -1, 0) end
            if md.Magnitude > 0 then
                c.CFrame = c.CFrame + (md.Unit * Cfg.FreecamSpeed * dt)
            end
        end)
    else
        if freecamConn then freecamConn:Disconnect(); freecamConn = nil end
        c.CameraType = Enum.CameraType.Custom
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h then c.CameraSubject = h end
    end
end

-- FLING PLAYER
local flingBusy = {}
local function flingPlayer(plr)
    if not plr or plr == LP then return false end
    if flingBusy[plr] then return false end
    flingBusy[plr] = true
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local tChar = plr.Character
    local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    if not (myHRP and myHum and tHRP) or (tHum and tHum.Health <= 0) then
        flingBusy[plr] = false
        return false
    end
    local success = pcall(function()
        pcall(function() myHRP:SetNetworkOwner(LP) end)
        pcall(function() myHum.PlatformStand = true end)
        pcall(function() myHum:ChangeState(Enum.HumanoidStateType.Physics) end)
        pcall(function()
            for _, o in ipairs(myChar:GetChildren()) do
                if o:IsA("Accessory") or o:IsA("Hat") then o:Destroy() end
            end
        end)
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
        pcall(function() myHRP.CFrame = tHRP.CFrame end)
        task.wait(0.05)
        if not (myHRP.Parent and tHRP.Parent) then return end
        local skid = Instance.new("Part")
        skid.Name = "BH_FlingSpin"
        skid.Size = Vector3.new(100, 100, 100)
        skid.Transparency = 1
        skid.CanCollide = false
        skid.CanQuery = false
        skid.CanTouch = false
        skid.Massless = false
        skid.CFrame = myHRP.CFrame
        skid.Parent = Workspace
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = myHRP
        weld.Part1 = skid
        weld.Parent = skid
        pcall(function() skid.RotVelocity = Vector3.new(9999, 9999, 9999) end)
        pcall(function()
            myHRP.AssemblyLinearVelocity = Vector3.new(math.random(-10,10), 3, math.random(-10,10))
        end)
        task.wait(0.15)
        if weld and weld.Parent then pcall(function() weld:Destroy() end) end
        if skid and skid.Parent then pcall(function() skid:Destroy() end) end
        if myHRP and myHRP.Parent then
            pcall(function()
                myHRP.AssemblyLinearVelocity = Vector3.zero
                myHRP.AssemblyAngularVelocity = Vector3.zero
                myHRP.Velocity = Vector3.zero
                myHRP.RotVelocity = Vector3.zero
                myHRP.CFrame = myHRP.CFrame + Vector3.new(0, 6, 0)
            end)
        end
        task.wait(0.05)
    end)
    if myHum and myHum.Parent then
        pcall(function()
            myHum.PlatformStand = false
            myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    flingBusy[plr] = false
    return success
end

