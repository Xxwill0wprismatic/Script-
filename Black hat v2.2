Instance.new("UICorner", nf).CornerRadius = UDim.new(0, 8)
Instance.new("UIStroke", nf).Color = PURPLE
local nl = Instance.new("TextLabel")
nl.Size = UDim2.new(1, -16, 1, 0)
nl.Position = UDim2.new(0, 8, 0, 0)
nl.BackgroundTransparency = 1
nl.Text = ""
nl.TextColor3 = PURPLE_LT
nl.Font = Enum.Font.GothamBold
nl.TextSize = 12
nl.TextXAlignment = Enum.TextXAlignment.Left
nl.ZIndex = 2001
nl.Parent = nf
local nth
local function notify(t)
    nl.Text = t
    nf.Visible = true
    nf.BackgroundTransparency = 0
    if nth then
        pcall(task.cancel, nth)
        nth = nil
    end
    nth = task.delay(2, function()
        if nf and nf.Parent then
            pcall(function()
                TweenService:Create(nf, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
            end)
            task.wait(0.35)
            if nf and nf.Parent then
                nf.Visible = false
                nf.BackgroundTransparency = 0
            end
        end
        nth = nil
    end)
end

