UIS.InputBegan:Connect(function(input, gp)
    if not (Cfg.AutoClickerArmed or Cfg.AutoClicker) then return end
    if UIS.TouchEnabled then
        if input.UserInputType ~= Enum.UserInputType.Touch then return end
    else
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    end
    if Main.Visible then
        local mp = Vector2.new(input.Position.X, input.Position.Y)
        local mPos = Main.AbsolutePosition
        local mSize = Main.AbsoluteSize
        if mp.X >= mPos.X and mp.X <= mPos.X + mSize.X and
           mp.Y >= mPos.Y and mp.Y <= mPos.Y + mSize.Y then
            return
        end
    end
    if Cfg.AutoClickerArmed then
        local pos = Vector2.new(input.Position.X, input.Position.Y)
        Cfg.AutoClickPoint = pos
        Cfg.AutoClickerArmed = false
        Cfg.AutoClicker = true
        autoClickerErrored = false
        if acBtnRefresh then acBtnRefresh() end
        showMarker(pos)
        notify(string.format("Clicking at (%d, %d)", math.floor(pos.X), math.floor(pos.Y)))
    elseif Cfg.AutoClicker then
        if not Cfg.AutoClickerTapStop then return end
        Cfg.AutoClicker = false
        Cfg.AutoClickPoint = nil
        Cfg.AutoClickerArmed = false
        hideMarker()
        if acBtnRefresh then acBtnRefresh() end
        notify("Auto-clicker stopped")
    end
end)

