-- ==========================================================
-- PLAYER RESOLUTION (rewritten — accepts ANY rig)
-- ==========================================================
-- grab any part on a character that we can use for positioning
local function getRoot(plr)
    local ch = plr and plr.Character
    if not ch or not ch.Parent then return nil end
    -- prefer the humanoid's own root
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum and hum.RootPart and hum.RootPart.Parent then
        return hum.RootPart
    end
    -- standard names, in priority order
    local names = {"HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head"}
    for _, n in ipairs(names) do
        local part = ch:FindFirstChild(n)
        if part and part:IsA("BasePart") then return part end
    end
    -- last resort: any BasePart that isn't obviously an accessory
    for _, d in ipairs(ch:GetChildren()) do
        if d:IsA("BasePart") and d.CanCollide then
            return d
        end
    end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end

-- returns a valid head part, or the topmost body part if Head doesn't exist
local function getHeadPart(plr)
    local ch = plr and plr.Character
    if not ch then return nil end
    local h = ch:FindFirstChild("Head")
    if h and h:IsA("BasePart") then return h end
    local best, bestY = nil, -math.huge
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("BasePart") then
            if d.Position.Y > bestY then
                bestY = d.Position.Y
                best = d
            end
        end
    end
    return best
end

-- list of {player, root} for every other player with a resolvable body
local function playersWithBody(requireHead)
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            if ch and ch.Parent then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local isAlive = (not hum) or hum.Health > 0
                local root = getRoot(p)
                if isAlive and root then
                    if not requireHead or getHeadPart(p) then
                        table.insert(out, {player = p, root = root})
                    end
                end
            end
        end
    end
    return out
end

local function nearestPlayer(range)
    local list = playersWithBody(false)
    if #list == 0 then return nil end
    local myRoot = getRoot(LP)
    local myPos = myRoot and myRoot.Position
    if not myPos then
        -- we don't have a body yet, just return the first
        return list[1].player
    end
    local best, bd = nil, math.huge
    for _, entry in ipairs(list) do
        local d = (entry.root.Position - myPos).Magnitude
        if d <= range and d < bd then
            bd = d
            best = entry.player
        end
    end
    if not best then
        -- everyone is out of range, pick the closest anyway
        for _, entry in ipairs(list) do
            local d = (entry.root.Position - myPos).Magnitude
            if d < bd then bd = d; best = entry.player end
        end
    end
    return best
end

local function randomPlayer(requireHead)
    local list = playersWithBody(requireHead)
    if #list == 0 then return nil end
    return list[math.random(1, #list)].player
end

local function teleportToPlayer(plr)
    if not plr then return false, "no target" end
    local myRoot = getRoot(LP)
    if not myRoot then return false, "your character isn't loaded" end
    local tRoot = getRoot(plr)
    if not tRoot then return false, plr.Name .. " has no body" end
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
    return true, "TP'd to " .. plr.Name
end

-- count for debug/notify
local function otherPlayerCount()
    local n = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then n = n + 1 end
    end
    return n
end

-- ==========================================================
local function alive(p)
    local c = p and p.Character
    if not c or not c.Parent then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return true end
    return h.Health > 0
end

