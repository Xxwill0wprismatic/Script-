        end
        entries = {}
        local q = searchBox.Text:lower()
        local y = 4
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and (q == "" or p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true)) then
                local btn = Instance.new("TextButton")
