-- X-RAY
local xraySaved = {}
local xrayRunning = false
local function applyXRay()
    if xrayRunning then return end
    xrayRunning = true
    task.spawn(function()
        local n = 0
        for _, d in ipairs(Workspace:GetDescendants()) do
            if not Cfg.XRay then break end
            if d:IsA("BasePart") then
                local myCh = LP.Character
