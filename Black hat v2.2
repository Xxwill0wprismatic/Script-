-- ESP
local playerTags = {}
local function teardownESP(p)
    local t = playerTags[p]
    if not t then return end
    for _, o in pairs(t) do
        if o and o.Destroy then pcall(function() o:Destroy() end) end
    end
    playerTags[p] = nil
end
local function espAnchorFor(p)
    local c = p.Character
    if not c then return nil end
    return c:FindFirstChild("Head") or getRoot(p)
end
local function buildESPFor(p)
    local anchor = espAnchorFor(p)
    if not anchor then return nil end
    local bg = Instance.new("BillboardGui")
    bg.Adornee = anchor
    bg.Size = UDim2.new(0, 200, 0, 52)
    bg.StudsOffset = Vector3.new(0, 3, 0)
    bg.AlwaysOnTop = true
    bg.LightInfluence = 0
    bg.Parent = anchor
    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 0, 16)
    nameLbl.Position = UDim2.new(0, 0, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = p.Name
    nameLbl.TextColor3 = PURPLE_LT
    nameLbl.TextStrokeTransparency = 0
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 12
    nameLbl.Parent = bg
    local distLbl = Instance.new("TextLabel")
    distLbl.Size = UDim2.new(1, 0, 0, 12)
    distLbl.Position = UDim2.new(0, 0, 0, 16)
    distLbl.BackgroundTransparency = 1
    distLbl.Text = "0m"
    distLbl.TextColor3 = TEXT
    distLbl.TextStrokeTransparency = 0
    distLbl.Font = Enum.Font.Gotham
    distLbl.TextSize = 10
    distLbl.Parent = bg
    local hpBg = Instance.new("Frame")
    hpBg.Size = UDim2.new(1, -40, 0, 5)
    hpBg.Position = UDim2.new(0, 20, 0, 32)
    hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    hpBg.BorderSizePixel = 0
    hpBg.Parent = bg
    Instance.new("UICorner", hpBg).CornerRadius = UDim.new(1, 0)
    local hpFill = Instance.new("Frame")
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.BackgroundColor3 = GREEN
    hpFill.BorderSizePixel = 0
    hpFill.Parent = hpBg
    Instance.new("UICorner", hpFill).CornerRadius = UDim.new(1, 0)
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.ZIndex = 400
    box.Parent = sg
    Instance.new("UIStroke", box).Color = PURPLE_LT
    return {bg = bg, name = nameLbl, dist = distLbl, hpBg = hpBg, hpFill = hpFill, box = box}
end
RunService.RenderStepped:Connect(function()
    local espOn = Cfg.ESPPlayers
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            if espOn then
                if not playerTags[p] or (playerTags[p] and not playerTags[p].bg.Parent) then
                    if playerTags[p] then teardownESP(p) end
                    playerTags[p] = buildESPFor(p)
                end
            else
                if playerTags[p] then teardownESP(p) end
            end
        else
            if playerTags[p] then teardownESP(p) end
        end
    end
    if not espOn then return end
    local cc = cam()
    if not cc then return end
    local myHrp = getRoot(LP)
    local keys = {}
    for p in pairs(playerTags) do table.insert(keys, p) end
    for _, p in ipairs(keys) do
        local t = playerTags[p]
        if t then
            local c = p.Character
            if not c or not c.Parent then
                teardownESP(p)
            else
                local anchor = espAnchorFor(p)
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = getRoot(p)
                if not (anchor and hum and hum.Health > 0) then
                    if t.bg then t.bg.Enabled = false end
                    if t.box then t.box.Visible = false end
                else
                    if t.bg then
                        t.bg.Enabled = true
                        if t.bg.Adornee ~= anchor then t.bg.Adornee = anchor end
                    end
                    if t.name then
                        t.name.Visible = Cfg.ESPName
                        t.name.Text = p.Name
                    end
                    if t.dist then
                        t.dist.Visible = Cfg.ESPDistance
                        if myHrp and root then
                            local d = math.floor((myHrp.Position - root.Position).Magnitude)
                            t.dist.Text = d .. "m"
                        end
                    end
                    if t.hpBg then t.hpBg.Visible = Cfg.ESPHealth end
                    if t.hpFill then
                        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        t.hpFill.Size = UDim2.new(pct, 0, 1, 0)
                        t.hpFill.BackgroundColor3 = pct > 0.6 and GREEN or pct > 0.3 and GOLD or RED
                    end
                    if t.box then
                        if Cfg.ESPBox and root then
                            local top = anchor.Position + Vector3.new(0, 1.2, 0)
                            local bot = root.Position - Vector3.new(0, 2.5, 0)
                            local ts, tOn = cc:WorldToViewportPoint(top)
                            local bs, bOn = cc:WorldToViewportPoint(bot)
                            if tOn and bOn then
                                local topY = math.min(ts.Y, bs.Y)
                                local botY = math.max(ts.Y, bs.Y)
                                local midX = (ts.X + bs.X) / 2
                                local h = botY - topY
                                if h > 0 then
                                    local w = h / 2
                                    t.box.Position = UDim2.new(0, midX - w/2, 0, topY)
                                    t.box.Size = UDim2.new(0, w, 0, h)
                                    t.box.Visible = true
                                else
                                    t.box.Visible = false
                                end
                            else
                                t.box.Visible = false
                            end
                        else
                            t.box.Visible = false
                        end
                    end
                end
            end
        end
    end
end)

-- TRACER
local tracerHolder = Instance.new("Frame")
tracerHolder.Name = "BH_TracerHolder"
tracerHolder.Size = UDim2.new(1, 0, 1, 0)
tracerHolder.BackgroundTransparency = 1
tracerHolder.BorderSizePixel = 0
tracerHolder.ZIndex = 5
tracerHolder.Active = false
tracerHolder.Parent = sg
RunService.RenderStepped:Connect(function()
    local activeKeys = {}
    if Cfg.ESPTracer then
        pcall(function()
            local c = cam()
            if not c then return end
            local vp = c.ViewportSize
            local originX = vp.X * 0.5
            local originY = vp.Y - 2
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local hr = getRoot(p)
                    local u = p.Character:FindFirstChildOfClass("Humanoid")
                    if hr and u and u.Health > 0 then
                        local sp, on = c:WorldToViewportPoint(hr.Position)
                        if on then
                            local key = "tr_" .. p.UserId
                            activeKeys[key] = true
                            local line = tracerHolder:FindFirstChild(key)
                            if not line then
                                line = Instance.new("Frame")
                                line.Name = key
                                line.BackgroundColor3 = PURPLE_LT
                                line.BorderSizePixel = 0
                                line.AnchorPoint = Vector2.new(0, 0.5)
                                line.ZIndex = 6
                                line.Parent = tracerHolder
                            end
                            local dx = sp.X - originX
                            local dy = sp.Y - originY
                            local len = math.sqrt(dx * dx + dy * dy)
                            if len > 0.5 then
                                line.Size = UDim2.fromOffset(len, 1)
                                line.Position = UDim2.fromOffset(originX, originY)
                                line.Rotation = math.deg(math.atan2(dy, dx))
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        end
                    end
                end
            end
        end)
    end
    for _, child in ipairs(tracerHolder:GetChildren()) do
        if not activeKeys[child.Name] then child:Destroy() end
    end
end)

