local function logErr(m)
    table.insert(errLines, 1, tostring(m))
    while #errLines > 5 do table.remove(errLines) end
    ErrLbl.Text = table.concat(errLines, "\n")
    ErrLbl.Visible = true
    warn("[BH] " .. tostring(m))
end

