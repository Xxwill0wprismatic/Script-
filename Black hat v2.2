                btn.Position = UDim2.new(0, 4, 0, y)
                btn.BackgroundColor3 = BLACK2
                btn.BorderSizePixel = 0
                btn.Text = p.Name .. " (" .. actionLabel .. ")"
                btn.TextColor3 = PURPLE_LT
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 10
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.AutoButtonColor = false
                btn.ZIndex = 16
                btn.Parent = list
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
                btn.MouseButton1Click:Connect(function()
                    local ok, err = pcall(actionCb, p)
                    if not ok then logErr(actionLabel .. " failed: " .. tostring(err)) end
                end)
                table.insert(entries, {button=btn, player=p})
                y = y + 24
            end
        end
        list.CanvasSize = UDim2.new(0, 0, 0, y + 4)
    end
    searchBox:GetPropertyChangedSignal("Text"):Connect(refresh)
    local conn1 = Players.PlayerAdded:Connect(function()
        task.wait(0.3)
        refresh()
    end)
    local conn2 = Players.PlayerRemoving:Connect(function()
        task.wait(0.1)
        refresh()
    end)
    registerCleanup(function()
        pcall(function() conn1:Disconnect() end)
        pcall(function() conn2:Disconnect() end)
    end)
    refresh()
end

-- SERVER BROWSER
local function httpGet(url)
    if game.HttpGet then
        local ok, res = pcall(function() return game:HttpGet(url, true) end)
        if ok and res then return res end
    end
    if HttpService.HttpEnabled then
        local ok, res = pcall(function() return HttpService:GetAsync(url, true) end)
        if ok and res then return res end
    end
    return nil
end
local function fetchServerList()
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    local raw = httpGet(url)
    if not raw then return nil, "HTTP unavailable (executor lacks game:HttpGet and HttpService.HttpEnabled=false)" end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or type(decoded) ~= "table" then return nil, "bad response" end
    return decoded.data or decoded, nil
end
local function buildServerBrowser()
    local tab = Tabs["Servers"]
    if not tab then return end
    newSection("Servers", "Current Server")
    newAction("Servers", "Copy Current Job ID", function()
        if setclipboard then pcall(function() setclipboard(game.JobId) end) end
        notify("Job ID copied")
    end)
    newAction("Servers", "Rejoin Current Server", function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
    end)
    newSection("Servers", "Browser")
    local statusY = tab.ypos
    tab.ypos = tab.ypos + 20
    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(1, -8, 0, 18)
    statusLbl.Position = UDim2.new(0, 4, 0, statusY)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Idle. Tap Refresh."
    statusLbl.TextColor3 = MUTED
    statusLbl.Font = Enum.Font.GothamBold
    statusLbl.TextSize = 10
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.ZIndex = 15
    statusLbl.Parent = tab.page
    local listY = tab.ypos
    tab.ypos = tab.ypos + 320
    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(1, -8, 0, 320)
    list.Position = UDim2.new(0, 4, 0, listY)
    list.BackgroundColor3 = BLACK
    list.BorderSizePixel = 0
    list.ScrollBarThickness = 3
    list.ScrollBarImageColor3 = PURPLE
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.ZIndex = 15
    list.Parent = tab.page
    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
    local entries = {}
    local function clear()
        for _, e in ipairs(entries) do
            if e and e.Parent then e:Destroy() end
        end
        entries = {}
    end
    local function render(data)
        clear()
        if not data or #data == 0 then
            statusLbl.Text = "No public servers returned."
            statusLbl.TextColor3 = RED
            return
        end
        table.sort(data, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
        local y = 4
        local curId = game.JobId
        for _, s in ipairs(data) do
            local sid = tostring(s.id or "?")
            local playing = tonumber(s.playing) or 0
            local maxp = tonumber(s.maxPlayers) or 0
            local ping = tonumber(s.ping) or -1
            local isCur = (sid == curId)
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, -8, 0, 40)
            row.Position = UDim2.new(0, 4, 0, y)
            row.BackgroundColor3 = isCur and PURPLE_DK or BLACK2
            row.BorderSizePixel = 0
            row.Text = ""
            row.AutoButtonColor = false
            row.ZIndex = 16
            row.Parent = list
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
            local st = Instance.new("UIStroke", row)
            st.Color = isCur and GREEN or PURPLE
            st.Thickness = 1
            st.Transparency = 0.5
            local l1 = Instance.new("TextLabel")
            l1.Size = UDim2.new(1, -12, 0, 16)
            l1.Position = UDim2.new(0, 8, 0, 3)
            l1.BackgroundTransparency = 1
            l1.Text = string.format("%s%s", string.sub(sid, 1, 12) .. "...", isCur and "  [YOU]" or "")
            l1.TextColor3 = PURPLE_LT
            l1.Font = Enum.Font.GothamBold
            l1.TextSize = 11
            l1.TextXAlignment = Enum.TextXAlignment.Left
            l1.ZIndex = 17
            l1.Parent = row
            local l2 = Instance.new("TextLabel")
            l2.Size = UDim2.new(1, -12, 0, 14)
            l2.Position = UDim2.new(0, 8, 0, 20)
            l2.BackgroundTransparency = 1
            l2.Text = string.format("Players %d/%d   Ping %s", playing, maxp, ping >= 0 and (ping .. "ms") or "?")
            l2.TextColor3 = TEXT
            l2.Font = Enum.Font.Gotham
            l2.TextSize = 10
            l2.TextXAlignment = Enum.TextXAlignment.Left
            l2.ZIndex = 17
            l2.Parent = row
            row.MouseButton1Click:Connect(function()
                if isCur then notify("Already in this server"); return end
                notify("Joining " .. string.sub(sid, 1, 8) .. "...")
                local ok, err = pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, sid, LP)
                end)
                if not ok then logErr("Join failed: " .. tostring(err)) end
            end)
            table.insert(entries, row)
            y = y + 44
        end
        list.CanvasSize = UDim2.new(0, 0, 0, y + 4)
        statusLbl.Text = string.format("Fetched %d servers.", #data)
        statusLbl.TextColor3 = GREEN
    end
    newAction("Servers", "Refresh Server List", function()
        statusLbl.Text = "Fetching..."
        statusLbl.TextColor3 = GOLD
        local ok, dataOrErr, maybeErr = pcall(fetchServerList)
        if not ok then
            statusLbl.Text = "Fetch failed: " .. tostring(dataOrErr)
            statusLbl.TextColor3 = RED
            return
        end
        local data, err = dataOrErr, maybeErr
        if not data then
            statusLbl.Text = "Fetch failed: " .. tostring(err)
            statusLbl.TextColor3 = RED
            return
        end
        render(data)
    end)
    newSection("Servers", "Random")
    newAction("Servers", "Join Random Public Server", function()
        statusLbl.Text = "Fetching for random..."
        statusLbl.TextColor3 = GOLD
        local ok, dataOrErr, maybeErr = pcall(fetchServerList)
        if not ok or not dataOrErr then
            statusLbl.Text = "Fetch failed"
            statusLbl.TextColor3 = RED
            return
        end
        local data = dataOrErr
        local choices = {}
        for _, s in ipairs(data) do
            local sid = tostring(s.id or "")
            if sid ~= "" and sid ~= game.JobId and (tonumber(s.playing) or 0) < (tonumber(s.maxPlayers) or 0) then
                table.insert(choices, sid)
            end
        end
        if #choices == 0 then notify("No joinable servers"); return end
        local pick = choices[math.random(1, #choices)]
        notify("Joining random...")
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, pick, LP)
        end)
    end)
end

