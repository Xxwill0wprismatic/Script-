    b.AutoButtonColor = false
    b.ZIndex = 15
    b.Parent = tab.page
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local function ref()
        local on = Cfg[key]
        b.Text = label .. ": " .. (on and "ON" or "OFF")
        b.BackgroundColor3 = on and PURPLE_DK or BLACK
        b.TextColor3 = on and PURPLE_LT or TEXT
