local rejoinInProgress = false
local function attemptRejoin(reason)
    if rejoinInProgress then return end
    if not Cfg or not Cfg.RejoinOnKick then return end
    rejoinInProgress = true
    print("[BH] kick detected (" .. tostring(reason) .. "), attempting rejoin")
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
    end)
end
