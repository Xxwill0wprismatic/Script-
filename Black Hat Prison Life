local function isWanted(p)
    if not p.Character then return false end
    local ok, wanted = pcall(function() return p.Character:GetAttribute("Wanted") end)
    if ok and wanted == true then return true end
    local ok2, status = pcall(function() return p.Character:GetAttribute("Status") end)
    if ok2 and (status == "Arrestable" or status == "Trespassing" or status == "Wanted") then
        return true
    end
    local ok3, arrest = pcall(function() return p.Character:GetAttribute("Arrestable") end)
    if ok3 and arrest == true then return true end
    return false
end

local function isTargetEnemy(p)
    local myTeam = getTeamName(LP)
    local theirTeam = getTeamName(p)
    if theirTeam == "Neutral" then return false end
    if myTeam == "Criminals" then
        return theirTeam == "Guards"
    end
    if myTeam == "Guards" then
        if theirTeam == "Criminals" then return true end
        if theirTeam == "Inmates" and isWanted(p) then return true end
        return false
    end
    if myTeam == "Inmates" then
        return theirTeam == "Criminals"
    end
    return false
end

