local function matchesKeys(name, keys)
    local n = name:lower()
    for _, k in ipairs(keys) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function isHeld(tool)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and tool:IsDescendantOf(p.Character) then return true end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        local bp = p:FindFirstChildOfClass("Backpack")
        if bp and tool:IsDescendantOf(bp) then return true end
    end
    return false
end

local function findSpawnedTool(keys)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Tool") and matchesKeys(v.Name, keys) and not isHeld(v) then return v end
    end
    return nil
end

local function findHeldTool(keys)
    local bp = getBackpack()
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and matchesKeys(t.Name, keys) then return t end
        end
    end
    local c = getChar()
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and matchesKeys(t.Name, keys) then return t end
        end
    end
    return nil
end

local function isVisible(targetPart)
    local cam = getCam()
    if not cam then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local c = getChar()
    if c then params.FilterDescendantsInstances = {c} end
    local dir = (targetPart.Position - cam.CFrame.Position)
    local result = workspace:Raycast(cam.CFrame.Position, dir, params)
    if not result then return true end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and result.Instance:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

-- SAFE TP
local function safeTP(targetPos, statusCb, skipClamp)
    local root = getRoot(); if not root then return false end
    local h = getHum(); if h then lastSafeHealth = h.Health end

    local now = tick()
    if now - lastTPTime < 0.15 then task.wait(0.15 - (now - lastTPTime)) end
    lastTPTime = tick()
    recentlyTeleported = tick()

    local finalY = targetPos.Y
    if not skipClamp then
        local params = RaycastParams.new()
        local c = getChar()
        if c then params.FilterDescendantsInstances = {c} end
        params.FilterType = Enum.RaycastFilterType.Exclude
        local hit = workspace:Raycast(targetPos + Vector3.new(0, 8, 0), Vector3.new(0, -200, 0), params)
        if hit and hit.Position and hit.Position.Y < targetPos.Y - 1 then
            finalY = hit.Position.Y + 4
        end
    end

    local final = Vector3.new(targetPos.X, finalY, targetPos.Z)
    local delta = final - root.Position
    local dist = delta.Magnitude

    if dist > 250 then
        if statusCb then statusCb("walking " .. math.floor(dist)) end
        local steps = math.ceil(dist / 200)
        for _ = 1, steps do
            local remaining = (final - root.Position).Magnitude
            local stepDist = math.min(200, remaining)
            local stepPos = root.Position + (final - root.Position).Unit * stepDist
            root.CFrame = CFrame.new(Vector3.new(stepPos.X, finalY, stepPos.Z))
            root.Velocity = Vector3.zero
            task.wait(0.15)
            if h then
                if h.Health < lastSafeHealth - 3 and h.Health > 0 then
                    pcall(function() h.Health = lastSafeHealth end)
                end
                lastSafeHealth = h.Health
            end
        end
    else
        root.CFrame = CFrame.new(final)
    end
    root.Velocity = Vector3.zero
    pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)

    task.wait(0.1)
    if h then
        if h.Health < lastSafeHealth - 3 and h.Health > 0 then
            pcall(function() h.Health = lastSafeHealth end)
        end
    end
    recentlyTeleported = tick()
    return true
end

-- GRAB
local function grabTool(keys, statusCb)
    local root = getRoot()
    local hum = getHum()
    if not root or not hum then return false end
    local original = root.CFrame

    local tool = findSpawnedTool(keys)
    local targetPart, targetName
    if tool then
        targetPart = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        targetName = tool.Name
    end
    if not targetPart then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsA("Tool") and matchesKeys(v.Name, keys) then
                local skip = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and v:IsDescendantOf(p.Character) then skip = true; break end
                end
                if not skip then targetPart = v; targetName = v.Name; break end
            end
        end
    end
    if not targetPart then
        if statusCb then statusCb("not found") end
        return false
    end

    safeTP(targetPart.Position + Vector3.new(0, 3, 2), statusCb, true)
    task.wait(0.1)
    if statusCb then statusCb("walking into " .. targetName) end

    local grabbed = false
    for _ = 1, 4 do
        pcall(function() hum:MoveTo(targetPart.Position) end)
        for _ = 1, 8 do
            task.wait(0.08)
            if findHeldTool(keys) then grabbed = true; break end
            local dist = (root.Position - targetPart.Position).Magnitude
            if dist < 4 then
                pcall(function()
                    root.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1, 0))
                end)
                task.wait(0.06)
                if findHeldTool(keys) then grabbed = true; break end
            end
        end
        if grabbed then break end
    end

    root.CFrame = original
    root.Velocity = Vector3.zero
    task.wait(0.25)

    if grabbed then
        local finalTool = findHeldTool(keys)
        local h2 = getHum()
        local c2 = getChar()
        if finalTool and h2 and c2 then
            if finalTool.Parent ~= c2 then
                pcall(function() h2:EquipTool(finalTool) end)
                task.wait(0.15)
                if finalTool.Parent ~= c2 then
                    pcall(function() finalTool.Parent = c2 end)
                end
            end
        end
        if statusCb then statusCb("grabbed & equipped") end
        return true
    end
    if statusCb then statusCb("failed") end
    return false
end

