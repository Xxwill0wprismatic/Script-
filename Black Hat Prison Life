local function findLocation(keys)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v:IsA("Tool") then
            local n = v.Name:lower()
            for _, k in ipairs(keys) do
                if n == k then return v.Position, v.Name end
            end
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v:IsA("Tool") then
            local n = v.Name:lower()
            for _, k in ipairs(keys) do
                if n:find(k, 1, true) then return v.Position, v.Name end
            end
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") then
            local n = v.Name:lower()
            for _, k in ipairs(keys) do
                if n:find(k, 1, true) then
                    if v.PrimaryPart then return v.PrimaryPart.Position, v.Name end
                    local ok, cf = pcall(function() return v:GetPivot() end)
                    if ok and cf then return cf.Position, v.Name end
                end
            end
        end
    end
    return nil, nil
end

