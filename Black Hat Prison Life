        box.Size = UDim2.fromOffset(38, 20); box.Position = UDim2.new(1, -46, 0, 5)
        box.BackgroundColor3 = Color3.fromRGB(60, 30, 90)
        box.Text = ""; box.BorderSizePixel = 0; box.Parent = row
        Instance.new("UICorner", box).CornerRadius = UDim.new(1, 0)
        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(16, 16); knob.Position = UDim2.new(0, 2, 0, 2)
        knob.BackgroundColor3 = Color3.fromRGB(200, 200, 220); knob.BorderSizePixel = 0
        knob.Parent = box
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
        local on = S[key] and true or false
        local function refresh()
            TweenService:Create(knob, TweenInfo.new(0.15), {
                Position = on and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2)
            }):Play()
            box.BackgroundColor3 = on and Color3.fromRGB(140, 40, 210) or Color3.fromRGB(60, 30, 90)
        end
        refresh()
        box.MouseButton1Click:Connect(function()
            on = not on; S[key] = on; refresh()
            if cb then pcall(cb, on) end
        end)
    end

    local function makeSlider(parent, label, min, max, key, cb)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 44)
        row.BackgroundColor3 = Color3.fromRGB(32, 14, 48); row.BorderSizePixel = 0
        row.Parent = parent
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        local t = Instance.new("TextLabel")
        t.Size = UDim2.new(1, 0, 0, 18); t.Position = UDim2.new(0, 10, 0, 4)
        t.BackgroundTransparency = 1
        t.Text = label .. ": " .. tostring(math.floor(S[key]))
        t.TextColor3 = Color3.fromRGB(225, 215, 245)
        t.Font = Enum.Font.Gotham; t.TextSize = 11
        t.TextXAlignment = Enum.TextXAlignment.Left; t.Parent = row
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -20, 0, 12); bar.Position = UDim2.new(0, 10, 0, 26)
        bar.BackgroundColor3 = Color3.fromRGB(60, 30, 90); bar.BorderSizePixel = 0
        bar.Parent = row
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(170, 60, 240); fill.BorderSizePixel = 0
        fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
        local drag = false
        local function setFromX(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = min + (max - min) * rel
            S[key] = v
            fill.Size = UDim2.new(rel, 0, 1, 0)
            t.Text = label .. ": " .. math.floor(v)
            if cb then pcall(cb, v) end
        end
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                drag = true; setFromX(i.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                setFromX(i.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end)
    end

    local function makeButton(parent, label, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 30)
        b.BackgroundColor3 = Color3.fromRGB(70, 20, 110)
        b.Text = label; b.TextColor3 = Color3.fromRGB(230, 200, 255)
        b.Font = Enum.Font.GothamBold; b.TextSize = 12; b.BorderSizePixel = 0
        b.Parent = parent
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.MouseButton1Click:Connect(function() pcall(cb) end)
    end

    local toolsStatus
    local combat   = makeTab("⚔ Combat")
    local toolsTab = makeTab("🔧 Tools")
    local move     = makeTab("🏃 Move")
    local tp       = makeTab("✦ Teleport")
    local vis      = makeTab("👁 Visuals")

    -- COMBAT
    makeHeader(combat, "Aimbot")
    makeToggle(combat, "Aimbot (auto team+wall check)", "Aimbot")
    makeSlider(combat, "Aimbot Range", 50, 1000, "AimbotRange")
    makeToggle(combat, "Aimbot Wall Check", "AimbotWallCheck")
    makeHeader(combat, "Triggerbot (auto team check)")
    makeToggle(combat, "Triggerbot", "Triggerbot")
    makeToggle(combat, "Trigger Wall Check", "TriggerWallCheck")
    makeButton(combat, "🔍 Who Can I Shoot?", function()
        local myTeam = getTeamName(LP)
        local lines = {"My team: " .. myTeam}
        if myTeam == "Criminals" then
            table.insert(lines, "Can target: Guards")
        elseif myTeam == "Guards" then
            table.insert(lines, "Can target: Criminals + Wanted Inmates")
        elseif myTeam == "Inmates" then
            table.insert(lines, "Can target: Criminals")
        else
            table.insert(lines, "No team — cannot target anyone")
        end
        local count = 0
        for _, p in ipairs(getPlayers()) do
            if isTargetEnemy(p) then count = count + 1 end
        end
        table.insert(lines, "Valid targets visible: " .. count)
        if toolsStatus then toolsStatus.Text = table.concat(lines, "\n") end
    end)

    -- TOOLS
    makeHeader(toolsTab, "Click to grab")
    for _, toolDef in ipairs(TOOLS) do
        local td = toolDef
        makeButton(toolsTab, "🔥 Grab " .. td.label, function()
            if toolsStatus then toolsStatus.Text = "Grabbing " .. td.label .. "..." end
            grabTool(td.keys, function(s)
                if toolsStatus then toolsStatus.Text = td.label .. ": " .. s end
            end)
        end)
    end
    makeHeader(toolsTab, "Auto")
    makeToggle(toolsTab, "Auto Keycard on Drop", "AutoKeycard")
    makeHeader(toolsTab, "Status")
    toolsStatus = Instance.new("TextLabel")
    toolsStatus.Size = UDim2.new(1, 0, 0, 80)
    toolsStatus.BackgroundColor3 = Color3.fromRGB(25, 10, 40)
    toolsStatus.Text = "idle"
    toolsStatus.TextColor3 = Color3.fromRGB(200, 170, 240)
    toolsStatus.Font = Enum.Font.Code; toolsStatus.TextSize = 10
    toolsStatus.TextWrapped = true
    toolsStatus.TextYAlignment = Enum.TextYAlignment.Top
    toolsStatus.BorderSizePixel = 0
    toolsStatus.Parent = toolsTab
    Instance.new("UICorner", toolsStatus).CornerRadius = UDim.new(0, 6)

    -- MOVE
    makeHeader(move, "Speed")
    makeToggle(move, "Speed Hack", "Speed")
    makeSlider(move, "Speed Value", 16, 200, "SpeedValue")
    makeHeader(move, "Physics")
    makeToggle(move, "Noclip", "Noclip")
    makeSlider(move, "Jump Power", 50, 300, "JumpPower")
    makeHeader(move, "Defense")
    makeToggle(move, "Anti Arrest", "AntiArrest")
    makeToggle(move, "Anti Tase", "AntiTase")

    -- TELEPORT
    makeHeader(tp, "Players")
    makeButton(tp, "👤 TP to Nearest Target", function()
        local root = getRoot(); if not root then return end
        local nearest, nd = nil, math.huge
        for _, p in ipairs(getPlayers()) do
            if isTargetEnemy(p) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < nd then nearest, nd = p, d end
                end
            end
        end
        if nearest then
            local hrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if hrp then safeTP(hrp.Position + Vector3.new(0, 3, 0)) end
        end
    end)
    makeHeader(tp, "Locations")
    for _, loc in ipairs(LOCATIONS) do
        local lc = loc
        makeButton(tp, "📍 " .. lc.label, function()
            local pos, foundName = findLocation(lc.keys)
            if pos then
                safeTP(pos + Vector3.new(0, 4, 0))
                if toolsStatus then toolsStatus.Text = "TP " .. lc.label .. " → " .. foundName end
            else
                if toolsStatus then toolsStatus.Text = "NOT FOUND: " .. lc.label end
            end
        end)
    end

    -- VISUALS
    makeHeader(vis, "Render")
    makeToggle(vis, "Player ESP (team colored)", "ESP")
    makeToggle(vis, "Fullbright", "Fullbright")
    makeSlider(vis, "FOV", 40, 120, "FOV", function(v)
        local cam = getCam(); if cam then cam.FieldOfView = v end
    end)

    selectTab("⚔ Combat")

    UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == Enum.KeyCode.RightShift then gui.Enabled = not gui.Enabled end
    end)

    -- AIMBOT
    pcall(function() RunService:UnbindFromRenderStep("BHAimbot") end)
    RunService:BindToRenderStep("BHAimbot", Enum.RenderPriority.Camera.Value + 1, function()
        if not S.Aimbot then return end
        local cam = getCam(); if not cam then return end
        local nearest, nd = nil, math.huge
        local cp = cam.CFrame.Position
        for _, p in ipairs(getPlayers()) do
            if isTargetEnemy(p) then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local d = (head.Position - cp).Magnitude
                    if d < nd and d <= S.AimbotRange then
                        if not S.AimbotWallCheck or isVisible(head) then
                            nearest, nd = p, d
                        end
                    end
                end
            end
        end
        if nearest then
            local head = nearest.Character:FindFirstChild("Head")
            if head then cam.CFrame = CFrame.lookAt(cp, head.Position) end
        end
    end)

    -- ESP
    local espData = {}
    local function teamColor(p)
        local team = getTeamName(p)
        if team == "Guards" then return Color3.fromRGB(50, 120, 255) end
        if team == "Criminals" then return Color3.fromRGB(255, 50, 50) end
        if team == "Inmates" then return Color3.fromRGB(255, 150, 50) end
        return Color3.fromRGB(170, 0, 255)
    end
    local function makeESPFor(p)
        if espData[p] then return espData[p] end
        local ch = p.Character; if not ch then return nil end
        local col = teamColor(p)
        local hl = Instance.new("Highlight")
        hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = col; hl.OutlineColor = col
        hl.Adornee = ch; hl.Parent = gui
        local head = ch:FindFirstChild("Head")
        if not head then hl:Destroy(); return nil end
        local bg = Instance.new("BillboardGui")
        bg.Size = UDim2.fromOffset(200, 34)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true; bg.Adornee = head; bg.Parent = gui
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, 0, 0, 18)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = p.Name
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.Font = Enum.Font.GothamBold; nameLbl.TextSize = 13
        nameLbl.TextStrokeTransparency = 0; nameLbl.Parent = bg
        local teamLbl = Instance.new("TextLabel")
        teamLbl.Size = UDim2.new(1, 0, 0, 16)
        teamLbl.Position = UDim2.fromOffset(0, 18)
        teamLbl.BackgroundTransparency = 1
        teamLbl.Text = "[" .. getTeamName(p) .. "]"
        teamLbl.TextColor3 = col
        teamLbl.Font = Enum.Font.GothamBold; teamLbl.TextSize = 11
        teamLbl.TextStrokeTransparency = 0; teamLbl.Parent = bg
        espData[p] = {hl = hl, bg = bg, teamLbl = teamLbl}
        return espData[p]
    end
    Players.PlayerRemoving:Connect(function(p)
        local d = espData[p]
        if d then
            pcall(function() d.hl:Destroy() end)
            pcall(function() d.bg:Destroy() end)
            espData[p] = nil
        end
    end)

    -- MAIN LOOP
    local prev = { Speed = false, JumpPower = 50, Noclip = false }
    RunService.Heartbeat:Connect(function()
        pcall(function()
            local h, r = getHum(), getRoot()
            if h and r then
                if S.Speed then
                    if h.WalkSpeed ~= S.SpeedValue then h.WalkSpeed = S.SpeedValue end
                elseif prev.Speed then
                    h.WalkSpeed = 16
                end
                prev.Speed = S.Speed

                if S.JumpPower ~= 50 then
                    h.UseJumpPower = true; h.JumpPower = S.JumpPower
                elseif prev.JumpPower ~= 50 then
                    h.JumpPower = 50
                end
                prev.JumpPower = S.JumpPower

                if S.Noclip then
                    for _, v in ipairs(getChar():GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                            pcall(function() v.CollisionGroup = "BHRV_NoClip" end)
                        end
                    end
                elseif prev.Noclip then
                    for _, v in ipairs(getChar():GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = true
                            pcall(function() v.CollisionGroup = "Default" end)
                        end
                    end
                end
                prev.Noclip = S.Noclip

                if S.AntiTase then
                    if h.WalkSpeed < 16 then h.WalkSpeed = S.Speed and S.SpeedValue or 16 end
                    if r.Anchored then r.Anchored = false end
                    pcall(function() if h.PlatformStand then h.PlatformStand = false end end)
                end

                if S.AntiArrest then
                    if h.PlatformStand then
                        pcall(function() h.PlatformStand = false end)
                    end
                    if r.Anchored then r.Anchored = false end
                end

                if tick() - recentlyTeleported > 1.5 then
                    if h.Health < lastSafeHealth - 5 and h.Health > 0 then
                        local inCombat = false
                        for _, p in ipairs(getPlayers()) do
                            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                            if hrp and (hrp.Position - r.Position).Magnitude < 15 then
                                inCombat = true; break
                            end
                        end
                        if not inCombat then
                            pcall(function() h.Health = lastSafeHealth end)
                        end
                    end
                    lastSafeHealth = h.Health
                end
            end

            if S.ESP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local d = espData[p]
                        if d and d.hl and d.hl.Adornee ~= p.Character then
                            pcall(function() d.hl:Destroy() end)
                            pcall(function() d.bg:Destroy() end)
                            espData[p] = nil
                        end
                        local nd = makeESPFor(p)
                        if nd then
                            local col = teamColor(p)
                            pcall(function()
                                nd.hl.FillColor = col
                                nd.hl.OutlineColor = col
                                nd.hl.Enabled = true
                                nd.bg.Enabled = true
                                nd.teamLbl.Text = "[" .. getTeamName(p) .. "]"
                                nd.teamLbl.TextColor3 = col
                            end)
                        end
                    end
                end
            else
                for _, d in pairs(espData) do
                    pcall(function() d.hl.Enabled = false end)
                    pcall(function() d.bg.Enabled = false end)
                end
            end
        end)
    end)

    RunService.RenderStepped:Connect(function()
        pcall(function()
            local cam = getCam(); if not cam then return end
            if S.Fullbright then
                Lighting.Ambient = Color3.fromRGB(255, 255, 255)
                Lighting.Brightness = 5
                Lighting.ClockTime = 12
                Lighting.FogEnd = 1e6
            end
            if S.FOV ~= 70 then cam.FieldOfView = S.FOV end
        end)
    end)

    -- TRIGGERBOT with smart auto team check
    task.spawn(function()
        while gui.Parent do
            if S.Triggerbot then
                pcall(function()
                    local cam = getCam()
                    if cam then
                        local params = RaycastParams.new()
                        local c = getChar()
                        if c then
                            params.FilterDescendantsInstances = {c}
                            params.FilterType = Enum.RaycastFilterType.Exclude
                        end
                        local result = workspace:Raycast(
                            cam.CFrame.Position,
                            cam.CFrame.LookVector * 500,
                            params
                        )
                        if result and result.Instance then
                            for _, p in ipairs(getPlayers()) do
                                if p.Character and result.Instance:IsDescendantOf(p.Character) then
                                    if isTargetEnemy(p) then
                                        local myC = getChar()
                                        if myC then
                                            for _, t in ipairs(myC:GetChildren()) do
                                                if t:IsA("Tool") then
                                                    pcall(function() t:Activate() end)
                                                    break
                                                end
                                            end
                                        end
                                    end
                                    break
                                end
                            end
                        end
                    end
                end)
            end
            task.wait(0.06)
        end
    end)

    -- AUTO KEYCARD
    task.spawn(function()
        while gui.Parent do
            if S.AutoKeycard and not findHeldTool({"keycard"}) then
                pcall(function()
                    local kc = findSpawnedTool({"keycard"})
                    if kc then
                        grabTool({"keycard"}, function(s)
                            if toolsStatus then toolsStatus.Text = "AutoKeycard: " .. s end
                        end)
                    end
                end)
            end
            task.wait(1)
        end
    end)

    print("[BHRV] V1 loaded — platform:", Platform)
end

