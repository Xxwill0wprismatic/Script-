local filterSpam = true
local logDirty   = false
local pending    = {}
local pathCache  = setmetatable({}, {__mode = "k"})
local origNC     = nil

local REMOTE_CLASSES = {
    RemoteEvent = true,
    RemoteFunction = true,
    UnreliableRemoteEvent = true,
}
local REMOTE_METHODS = {
    FireServer = true,
    InvokeServer = true,
    FireClient = true,
    InvokeClient = true,
}
local SPAM = {
    ["ValidateCanChat"] = true,
    ["CanUsersDirectChatAsync"] = true,
    ["Ping"] = true,
    ["UpdateFFlag"] = true,
    ["UpdateCameraRotation"] = true,
    ["UpdateCameraRotations"] = true,
    ["RequestFFlags"] = true,
}

local function addLine(s)
    if paused and hooked then return end
    table.insert(logBuffer, s)
    if #logBuffer > 200 then table.remove(logBuffer, 1) end
    logDirty = true
end

local function buildPathCache()
    pathCache = setmetatable({}, {__mode = "k"})
    local function scan(root)
        for _, obj in ipairs(root:GetDescendants()) do
            if REMOTE_CLASSES[obj.ClassName] then
                pathCache[obj] = obj:GetFullName()
            end
        end
    end
    pcall(scan, RS)
    pcall(scan, game:GetService("ReplicatedFirst"))
    pcall(scan, workspace)
end

local function fmt(...)
    local n = select("#", ...)
    if n == 0 then return "" end
    local cap = math.min(n, 4)
    local parts = {}
    for i = 1, cap do
        local a = select(i, ...)
        local t = typeof(a)
        if t == "Instance" then
            parts[i] = a.ClassName .. ":" .. a.Name
        elseif t == "number" then
            parts[i] = tostring(a)
        elseif t == "string" then
            parts[i] = '"' .. a:sub(1, 30) .. '"'
        elseif t == "boolean" then
            parts[i] = tostring(a)
        elseif t == "Vector3" then
            parts[i] = string.format("V3(%.0f,%.0f,%.0f)", a.X, a.Y, a.Z)
        elseif t == "CFrame" then
            local p = a.Position
            parts[i] = string.format("CF(%.0f,%.0f,%.0f)", p.X, p.Y, p.Z)
        elseif t == "table" then
            local k = 0
            for _ in pairs(a) do k = k + 1; if k > 15 then break end end
            parts[i] = "{n=" .. k .. "}"
        else
            parts[i] = t
        end
    end
    if n > cap then parts[cap + 1] = "..." end
    return table.concat(parts, ", ")
end

task.spawn(function()
    while gui.Parent do
        if #pending > 0 then
            local batch = pending
            pending = {}
            for _, entry in ipairs(batch) do
                pcall(function()
                    if filterSpam and SPAM[entry.name] then return end
                    callCount = callCount + 1
                    addLine(">> " .. entry.m .. " [" .. (entry.us and "US" or "GAME") .. "] " .. entry.name)
                    addLine("   " .. (pathCache[entry.self] or entry.name))
                    local a = fmt(table.unpack(entry.args, 1, entry.argc))
                    if a ~= "" then addLine("   args: " .. a) end
                    addLine("")
                end)
            end
        end
        if logDirty then
            logDirty = false
            logLabel.Text = table.concat(logBuffer, "\n")
            if hooked then
                status.Text = string.format("LIVE | calls: %d | lines: %d | %s | filter: %s",
                    callCount, #logBuffer,
                    paused and "PAUSED" or "OK",
                    filterSpam and "ON" or "OFF")
            else
                status.Text = string.format("idle | lines: %d", #logBuffer)
            end
        end
        task.wait(0.1)
    end
end)

-- ============================================================
-- Hook — minimal
-- ============================================================
local function hookFn(self, ...)
    if active then
        if REMOTE_CLASSES[self.ClassName] then
            local m = getnamecallmethod()
            if REMOTE_METHODS[m] then
                pending[#pending + 1] = {
                    m = m, self = self, name = self.Name,
                    args = {...}, argc = select("#", ...),
                    us = checkcaller(),
                }
            end
        end
    end
    return origNC(self, ...)
end

local function installHook()
    if hooked then return true end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then error("no raw metatable") end
        setreadonly(mt, false)
        origNC = mt.__namecall
        mt.__namecall = hookFn
        setreadonly(mt, true)
    end)
    if not ok or not origNC then
        local ok2, err2 = pcall(function()
            origNC = hookmetamethod(game, "__namecall", hookFn)
        end)
        if not ok2 or not origNC then
            return false, err2 or "hook failed"
        end
    end
    G.__BH_RS_OLDNC = origNC
    hooked = true
    buildPathCache()
    return true
end

local function removeHook()
    if not hooked then return end
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        mt.__namecall = origNC
        setreadonly(mt, true)
    end)
    G.__BH_RS_OLDNC = nil
    hooked = false
end

