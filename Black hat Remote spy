-- Minimize (robust — no ClipsDescendants)
-- ============================================================
local minimized = false
local minimizing = false
local expandedSize = UDim2.fromOffset(400, 320)

local function collectContent()
    local list = {}
    for _, v in ipairs(main:GetChildren()) do
        if v ~= title and v ~= minBtn and v ~= cb and v:IsA("GuiObject") then
            table.insert(list, v)
        end
    end
    return list
end

minBtn.MouseButton1Click:Connect(function()
    if minimizing then return end
    minimizing = true
    local contents = collectContent()

    if not minimized then
        expandedSize = main.Size
        for _, v in ipairs(contents) do v.Visible = false end
        local t = TweenService:Create(main, TweenInfo.new(0.15), {
            Size = UDim2.fromOffset(expandedSize.X.Offset, 30)
        })
        t:Play()
        t.Completed:Connect(function()
            minimized = true
            minBtn.Text = "+"
            minimizing = false
        end)
    else
        local t = TweenService:Create(main, TweenInfo.new(0.15), {Size = expandedSize})
        t:Play()
        t.Completed:Connect(function()
            for _, v in ipairs(contents) do v.Visible = true end
            minimized = false
            minBtn.Text = "—"
            minimizing = false
        end)
    end
end)

