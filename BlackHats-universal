            task.spawn(function()
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum and ClickTP.tool then pcall(function() hum:EquipTool(ClickTP.tool) end) end
            end)
        end
    end
end)
