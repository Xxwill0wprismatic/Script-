local FC = {
    TPOffset = Vector3.new(0, 0, 0),
    TPWait = 0.01,
    WeldHoldTime = 1.5,
    SpinTorque = 2e10,
    SpinVelocity = 15000,
    SpinPartDensity = 8000,
    SpinPartSize = 4,
    SelfSpin = true,
    SelfSpinHold = 1.5,
    SelfSpinVelocity = 12000,
    PostFlingOffset = Vector3.new(0, 12, 0),
    LoopInterval = 1.5,
}
local flingCleanups = {}
local function ftrack(i) if i then flingCleanups[i] = true end; return i end
local function funtrack(i) flingCleanups[i] = nil end

local function makeSpinBlock(hrp, dir)
    local spin = Instance.new("Part")
    spin.Name = "FL_SpinBlock"
    spin.Size = Vector3.new(FC.SpinPartSize, FC.SpinPartSize, FC.SpinPartSize)
    spin.Transparency = 1; spin.CanCollide = false
    spin.CanQuery = false; spin.CanTouch = false; spin.Massless = false
    spin.CustomPhysicalProperties = PhysicalProperties.new(FC.SpinPartDensity, 0.3, 0.5, 1, 1)
    spin.CFrame = hrp.CFrame
    spin.Parent = Workspace; ftrack(spin)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hrp; weld.Part1 = spin
    weld.Parent = spin; ftrack(weld)
    local bav = Instance.new("BodyAngularVelocity")
    bav.AngularVelocity = Vector3.new(FC.SpinVelocity * dir, FC.SpinVelocity, FC.SpinVelocity * dir)
    bav.MaxTorque = Vector3.new(FC.SpinTorque, FC.SpinTorque, FC.SpinTorque)
    bav.P = 1e9; bav.Parent = spin; ftrack(bav)
    return spin, weld, bav
end

local function tpWeldSpin(targetChar)
    if not targetChar or not targetChar.Parent then return false end
    local tHrp = targetChar:FindFirstChild("HumanoidRootPart")
    local tHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not tHrp or not tHum or tHum.Health <= 0 then return false end
    local mChar = LP.Character
    local mHrp = mChar and mChar:FindFirstChild("HumanoidRootPart")
    local mHum = mChar and mChar:FindFirstChildOfClass("Humanoid")
    if not mHrp or not mHum or mHum.Health <= 0 then return false end
    for _, n in ipairs({"FL_SelfWeld","FL_SpinBlock","FL_SpinBlock2","FL_TargetSpin","FL_SelfSpin"}) do
        local old = tHrp:FindFirstChild(n) or mHrp:FindFirstChild(n)
        if old then pcall(function() old:Destroy() end) end
    end
    pcall(function() tHrp:SetNetworkOwner(LP) end)
    pcall(function() mHrp:SetNetworkOwner(LP) end)
    mHrp.AssemblyLinearVelocity = Vector3.zero
    mHrp.AssemblyAngularVelocity = Vector3.zero
    mHrp.CFrame = tHrp.CFrame * CFrame.new(FC.TPOffset)
    task.wait(FC.TPWait)
    if not (mHrp.Parent and tHrp.Parent) then return false end
    local selfWeld = Instance.new("WeldConstraint")
    selfWeld.Name = "FL_SelfWeld"
    selfWeld.Part0 = mHrp; selfWeld.Part1 = tHrp
    selfWeld.Parent = mHrp; ftrack(selfWeld)
    local tSpin = Instance.new("BodyAngularVelocity")
    tSpin.Name = "FL_TargetSpin"
    tSpin.AngularVelocity = Vector3.new(FC.SpinVelocity, FC.SpinVelocity, FC.SpinVelocity)
    tSpin.MaxTorque = Vector3.new(FC.SpinTorque, FC.SpinTorque, FC.SpinTorque)
    tSpin.P = 1e9; tSpin.Parent = tHrp; ftrack(tSpin)
    local spin1, weld1, bav1 = makeSpinBlock(tHrp, 1)
    local spin2, weld2, bav2 = makeSpinBlock(tHrp, -1)
    local mSpin = nil
    if FC.SelfSpin then
        mSpin = Instance.new("BodyAngularVelocity")
        mSpin.Name = "FL_SelfSpin"
        mSpin.AngularVelocity = Vector3.new(FC.SelfSpinVelocity, FC.SelfSpinVelocity, FC.SelfSpinVelocity)
        mSpin.MaxTorque = Vector3.new(FC.SpinTorque, FC.SpinTorque, FC.SpinTorque)
        mSpin.P = 1e9; mSpin.Parent = mHrp; ftrack(mSpin)
    end
    pcall(function() tHum.PlatformStand = true end)
    task.delay(FC.WeldHoldTime, function()
        for _, inst in ipairs({selfWeld, tSpin, weld1, weld2, bav1, bav2, spin1, spin2}) do
            if inst and inst.Parent then pcall(function() inst:Destroy() end); funtrack(inst) end
        end
        if tHum and tHum.Parent then pcall(function() tHum.PlatformStand = false end) end
    end)
    task.delay(FC.SelfSpinHold, function()
        if mSpin and mSpin.Parent then pcall(function() mSpin:Destroy() end); funtrack(mSpin) end
        if mHrp and mHrp.Parent then
            mHrp.AssemblyLinearVelocity = Vector3.zero
            mHrp.AssemblyAngularVelocity = Vector3.zero
            mHrp.CFrame = mHrp.CFrame + FC.PostFlingOffset
        end
    end)
    return true
end
local function flingPlayer(plr)
    if not plr or plr == LP then return false end
    return tpWeldSpin(plr.Character)
end

