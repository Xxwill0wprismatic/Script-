    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollingDirection = Enum.ScrollingDirection.Y
    page.ClipsDescendants = true; page.Visible = false
    page.ZIndex = 13; page.Parent = Content
    Tabs[name] = { button=btn, page=page, ypos=0, hidden=hidden }
    table.insert(TAB_ORDER, name)
    btn.MouseButton1Click:Connect(function()
        if btn.Visible == false then return end
        for _, t in pairs(Tabs) do
            t.page.Visible = false
            t.button.BackgroundColor3 = BLACK
            t.button.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        page.Visible = true
        btn.BackgroundColor3 = PURPLE_DARK
        btn.TextColor3 = PURPLE_LIGHT
        currentTab = name
    end)
    if not currentTab and not hidden then
        currentTab = name; page.Visible = true
        btn.BackgroundColor3 = PURPLE_DARK
        btn.TextColor3 = PURPLE_LIGHT
    end
    return btn
end

