-- ClickTP
local ClickTP = { enabled=false, tool=nil, equipped=false, busy=false,
    active=nil, startPos=Vector2.zero, cancelled=false, stepConn=nil,
    hovered=nil, shownAt=0, toolConns={}, glow=nil }
local CT = { TOOL_NAME="Clicktp", MIN_GLOW_TIME=0.25, SWIPE_CANCEL_PX=24 }
ClickTP.glow = Instance.new("Highlight")
ClickTP.glow.FillColor = Color3.fromRGB(0,110,255)
ClickTP.glow.OutlineColor = Color3.fromRGB(90,180,255)
ClickTP.glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
ClickTP.glow.Parent = sg
local function ctClear() ClickTP.hovered = nil; ClickTP.glow.Adornee = nil end
local function ctCast(ray)
    local filter = { LP.Character }
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    for _ = 1, 8 do
        local r = Workspace:Raycast(ray.Origin, ray.Direction.Unit*3000, params)
        if not r then return nil end
        local p = r.Instance
        if p ~= Workspace.Terrain and p.Transparency >= 0.99 and not p.CanCollide then
            filter[#filter+1] = p; params.FilterDescendantsInstances = filter
        else return r end
    end
    return nil
end
local function ctPos(i)
    if i.UserInputType == Enum.UserInputType.Touch then return Vector2.new(i.Position.X, i.Position.Y) end
    return UIS:GetMouseLocation()
end
local function ctRay(i)
    local c = cam(); if not c then return nil end
    local p = ctPos(i)
    if i.UserInputType == Enum.UserInputType.Touch then return c:ScreenPointToRay(p.X, p.Y) end
    return c:ViewportPointToRay(p.X, p.Y)
end
local function ctHover()
    local ray = ClickTP.active and ctRay(ClickTP.active)
    local r = ray and ctCast(ray)
    if r then
        if ClickTP.glow.Adornee ~= r.Instance then
            ClickTP.glow.Adornee = r.Instance; ClickTP.shownAt = os.clock()
        end
        ClickTP.hovered = r
    else ctClear() end
end
local function ctTP(res)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local n, p = res.Normal, res.Position
    local up = Vector3.new(0,1,0)
    local flat = Vector3.new(n.X, 0, n.Z)
    local target
    if n.Y > 0.6 then target = p + flat*1.5 + up*3
    elseif n.Y < -0.6 then target = p + n*3.5
    else
        local mag = flat.Magnitude
        if mag < 0.001 then return end
        target = p + (flat/mag)*2 + up*3
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(target) * (hrp.CFrame - hrp.CFrame.Position)
end
local function ctAbort()
    ClickTP.active = nil
    if ClickTP.stepConn then ClickTP.stepConn:Disconnect(); ClickTP.stepConn = nil end
    ctClear()
end
local function ctFinish()
    if not ClickTP.active then return end
    local target = ClickTP.hovered
    local cx = ClickTP.cancelled
    ClickTP.active = nil
    if ClickTP.stepConn then ClickTP.stepConn:Disconnect(); ClickTP.stepConn = nil end
    if cx or not target then ctClear(); return end
    ClickTP.busy = true
    task.spawn(function()
        local rem = CT.MIN_GLOW_TIME - (os.clock() - ClickTP.shownAt)
        if rem > 0 then task.wait(rem) end
        if ClickTP.enabled and ClickTP.equipped then pcall(ctTP, target) end
        ctClear(); ClickTP.busy = false
    end)
end
local function ctStep()
    if not ClickTP.active then return end
    if ClickTP.active.UserInputType == Enum.UserInputType.Touch then
        local st = ClickTP.active.UserInputState
        if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then ctFinish(); return end
        if not ClickTP.cancelled
        and (ctPos(ClickTP.active) - ClickTP.startPos).Magnitude > CT.SWIPE_CANCEL_PX then
            ClickTP.cancelled = true; ctClear()
        end
    end
    if not ClickTP.cancelled then ctHover() end
end
UIS.InputBegan:Connect(function(i, gp)
    if gp or not ClickTP.enabled or not ClickTP.equipped or ClickTP.busy or ClickTP.active then return end
    local t = i.UserInputType
    if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
    ClickTP.active = i; ClickTP.cancelled = false
    ClickTP.startPos = ctPos(i); ClickTP.shownAt = os.clock()
    ctHover()
    ClickTP.stepConn = RunService.RenderStepped:Connect(ctStep)
end)
UIS.InputEnded:Connect(function(i)
    if not ClickTP.active then return end
    if i == ClickTP.active
    or (ClickTP.active.UserInputType == Enum.UserInputType.MouseButton1
    and i.UserInputType == Enum.UserInputType.MouseButton1) then ctFinish() end
end)
local function ctRemove()
    for _, c in ipairs(ClickTP.toolConns) do pcall(function() c:Disconnect() end) end
    ClickTP.toolConns = {}
    if ClickTP.tool then pcall(function() ClickTP.tool:Destroy() end) end
    ClickTP.tool = nil; ClickTP.equipped = false
end
local function ctInstall()
    ctRemove()
    local bp = LP:FindFirstChildOfClass("Backpack") or LP:WaitForChild("Backpack", 10)
    if not bp then return false end
    local tool = Instance.new("Tool")
    tool.Name = CT.TOOL_NAME
    tool.RequiresHandle = false; tool.CanBeDropped = false
    ClickTP.toolConns[#ClickTP.toolConns+1] = tool.Equipped:Connect(function() ClickTP.equipped = true end)
    ClickTP.toolConns[#ClickTP.toolConns+1] = tool.Unequipped:Connect(function() ClickTP.equipped = false; ctAbort() end)
    tool.Parent = bp
    ClickTP.tool = tool
    return true
end
local function ctSetEnabled(on)
    ClickTP.enabled = on
    if on then
        if ctInstall() then
            task.spawn(function()
                local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hum and ClickTP.tool then pcall(function() hum:EquipTool(ClickTP.tool) end) end
            end)
        end
    else
        ctAbort(); ctRemove()
    end
end
LP.CharacterAdded:Connect(function()
    ClickTP.equipped = false; ctAbort()
    if Cfg.GiantBrick then
        task.wait(2)
        if Cfg.GiantBrick then spawnGiantBrick() end
    end
    if ClickTP.enabled then
        task.wait(1.5)
        if ClickTP.enabled then
