--========================================================================
-- AIMBOT V4.0
--========================================================================
local AimTarget = nil

local function selectAimPart(char)
    if Cfg.AimPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif Cfg.AimPart == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    else
        local c = cam(); if not c then return char:FindFirstChild("Head") end
        local sc = scrCenter()
        local best, bd = nil, math.huge
        for _, name in ipairs({"Head","UpperTorso","Torso","LowerTorso","HumanoidRootPart"}) do
            local p = char:FindFirstChild(name)
            if p then
                local sp = w2s(p.Position)
                if sp then
                    local d = (sp - sc).Magnitude
                    if d < bd then bd = d; best = p end
                end
            end
        end
        return best or char:FindFirstChild("HumanoidRootPart")
    end
end

local function scoreTarget(plr, part, dist, ang)
    if Cfg.AimbotPriority == "Distance" then return -dist end
    if Cfg.AimbotPriority == "Angle" then return -ang end
    if Cfg.AimbotPriority == "Health" then
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        return hum and -(hum.Health / math.max(hum.MaxHealth, 1)) or 0
    end
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    local hp = hum and (hum.Health / math.max(hum.MaxHealth, 1)) or 1
    return -dist * 0.5 - ang * 0.4 - hp * 200 * 0.1
end

local function smoothAim(camObj, targetPos)
    local current = camObj.CFrame
    local desired = CFrame.new(current.Position, targetPos)
    local alpha = 1 - (Cfg.AimbotSmooth / 100)
    if alpha <= 0 then camObj.CFrame = desired
    else
        local newLook = current.LookVector:Lerp(desired.LookVector, alpha)
        if newLook.Magnitude > 0.001 then
            camObj.CFrame = CFrame.new(current.Position, current.Position + newLook.Unit)
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not Cfg.AimbotEnabled then AimTarget = nil; aimLocked = false; return end
    local ok, err = pcall(function()
        if aimLocked and AimTarget and isAlive(AimTarget) then
            -- locked, skip re-scan
        else
            aimLocked = false
            local c = cam(); if not c then return end
            local cp = c.CFrame.Position
            local sc = scrCenter()
            local best, bestScore, bestPart = nil, -math.huge, nil
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and isAlive(plr) and not isSameTeam(plr) then
                    local char = plr.Character
                    local part = selectAimPart(char)
                    if part then
                        local d = (part.Position - cp).Magnitude
                        if d <= Cfg.MaxDistance then
                            local sp = w2s(part.Position)
                            if sp then
                                local ang = (sp - sc).Magnitude
                                if ang <= Cfg.FOV and hasLOS(part, char) then
                                    local s = scoreTarget(plr, part, d, ang)
                                    if s > bestScore then
                                        bestScore = s; best = plr; bestPart = part
                                    end
                                end
                            end
                        end
                    end
                end
            end
            AimTarget = best
            if Cfg.AimbotLockTarget and best then aimLocked = true end
        end
        if AimTarget and AimTarget.Character then
            local part = selectAimPart(AimTarget.Character)
            if part then
                local targetPos = predictPos(part)
                local c = cam()
                if c and (Cfg.AimbotMode == "Camera" or not Cfg.SilentAim) then
                    smoothAim(c, targetPos)
                end
                if Cfg.AutoShoot then
                    pcall(function()
                        local vim = game:GetService("VirtualInputManager")
                        local v = c.ViewportSize
                        vim:SendMouseButtonEvent(math.floor(v.X/2), math.floor(v.Y/2), 0, true, game, 0)
                        task.wait(0.01)
                        vim:SendMouseButtonEvent(math.floor(v.X/2), math.floor(v.Y/2), 0, false, game, 0)
                    end)
                end
            end
        end
    end)
    if not ok then logError("Aimbot: " .. tostring(err)) end
end)

