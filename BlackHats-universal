local function newToggle(tabName, label, key, onChanged, gold)
    local tab = Tabs[tabName]; if not tab then return end
    local y = nextY(tab)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -8, 0, ROW_H)
    b.Position = UDim2.new(0, 4, 0, y)
    b.BackgroundColor3 = BLACK; b.Text = label .. ": OFF"
    b.TextColor3 = Color3.fromRGB(220, 220, 220)
    b.Font = Enum.Font.GothamBold; b.TextSize = 11
    b.BorderSizePixel = 0; b.AutoButtonColor = false
    b.ZIndex = 15; b.Parent = tab.page
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local glow = Instance.new("UIStroke", b)
    glow.Color = gold and GOLD or PURPLE; glow.Thickness = 1; glow.Transparency = 1
    local function refresh()
        local on = Cfg[key]
        b.Text = label .. ": " .. (on and "ON" or "OFF")
        b.BackgroundColor3 = on and PURPLE_DARK or BLACK
        b.TextColor3 = on and (gold and GOLD or PURPLE_LIGHT) or Color3.fromRGB(220, 220, 220)
        glow.Transparency = on and 0.2 or 1
    end
    b.MouseButton1Click:Connect(function()
        Cfg[key] = not Cfg[key]; refresh()
        notify(label .. ": " .. (Cfg[key] and "ON" or "OFF"))
        if onChanged then pcall(onChanged, Cfg[key]) end
        if key == "Noclip" and not Cfg.Noclip then
            for p, was in pairs(originalCollide) do
                if p and p.Parent then pcall(function() p.CanCollide = was end) end
            end
            originalCollide = {}
        end
        if key == "Fullbright" and not Cfg.Fullbright then
            Lighting.Brightness = 1; Lighting.GlobalShadows = true
        end
        if key == "FullbrightExt" and not Cfg.FullbrightExt then
            Lighting.Ambient = Color3.fromRGB(70, 70, 70)
            Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
            Lighting.ColorShift_Top = Color3.new(0,0,0)
            Lighting.ColorShift_Bottom = Color3.new(0,0,0)
        end
        if key == "NoFog" and not Cfg.NoFog then Lighting.FogEnd = 100000 end
        if key == "ESPPlayers" and not Cfg.ESPPlayers then
            for _, t in pairs(playerTags) do
                if t.hl then t.hl:Destroy() end
                if t.bg then t.bg:Destroy() end
            end
            playerTags = {}
        end
        if key == "HitboxExpand" and not Cfg.HitboxExpand then
            for p, orig in pairs(originalSizes) do
                if p and p.Parent then pcall(function() p.Size = orig end) end
            end
            originalSizes = {}
        end
        if key == "XRay" and not Cfg.XRay then
            for p, orig in pairs(originalTransp) do
                if p and p.Parent then pcall(function() p.LocalTransparencyModifier = orig end) end
            end
            originalTransp = {}
        end
        if key == "HideSelf" and not Cfg.HideSelf then
            local c = LP.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
                end
            end
        end
        if key == "InvisibleSelf" and not Cfg.InvisibleSelf then
            local c = LP.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") or p:IsA("Decal") then
                        pcall(function() p.LocalTransparencyModifier = 0 end)
                    end
                end
