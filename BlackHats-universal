local function isAlive(plr)
    local c = plr and plr.Character
    if not c or not c.Parent then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function isSameTeam(plr)
    if not Cfg.TeamCheck then return false end
    return plr.Team ~= nil and plr.Team == LP.Team
end
local function w2s(pos)
    local c = cam(); if not c then return nil end
    local sp, on = c:WorldToViewportPoint(pos)
    if not on then return nil end
    return Vector2.new(sp.X, sp.Y)
end
local function scrCenter()
    local c = cam(); if not c then return Vector2.zero end
    local v = c.ViewportSize
    return Vector2.new(v.X/2, v.Y/2)
end
local function hasLOS(part, char)
    if not Cfg.WallCheck then return true end
    local c = cam(); if not c then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character, c }
    params.IgnoreWater = true
    local r = Workspace:Raycast(c.CFrame.Position, part.Position - c.CFrame.Position, params)
    if not r then return true end
    return r.Instance:IsDescendantOf(char)
end
local function ping()
    local ok, p = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    return ok and p or 0.05
end
local function predictPos(part)
    if Cfg.AimbotPrediction <= 0 then return part.Position end
    local vel = part.AssemblyLinearVelocity or Vector3.zero
    return part.Position + vel * (ping() + Cfg.AimbotPrediction)
end

