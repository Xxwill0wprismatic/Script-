                    elseif typeof(args[i]) == "CFrame" then args[i] = CFrame.new(c.CFrame.Position, targetPos) end
                end
                return old(self, table.unpack(args))
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

