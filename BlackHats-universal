-- Silent aim hook
pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if (Cfg.SilentAim or Cfg.AimbotMode == "Silent") and method == "FireServer" and AimTarget and AimTarget.Character then
            local hrp = AimTarget.Character:FindFirstChild("HumanoidRootPart")
            local c = cam()
            if hrp and c then
                local targetPos = predictPos(hrp)
                local args = {...}
                for i = 1, #args do
