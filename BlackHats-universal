RunService.RenderStepped:Connect(function()
    local ok, err = pcall(function()
        local char = LP.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp then return end
        if Cfg.Fly then
            if hum then hum.PlatformStand = true end
            local c = cam()
            local bv = hrp:FindFirstChild("BH_Fly")
            local bg = hrp:FindFirstChild("BH_Gyro")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "BH_Fly"; bv.MaxForce = Vector3.new(1e5,1e5,1e5)
                bv.P = 1250; bv.Velocity = Vector3.zero; bv.Parent = hrp
            end
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "BH_Gyro"; bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
                bg.P = 5000; bg.D = 500; bg.Parent = hrp
            end
            local md = Vector3.zero; local v = 0
            if c then
                if UIS:IsKeyDown(Enum.KeyCode.W) then md += c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then md -= c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then md -= c.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then md += c.CFrame.RightVector end
            end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then v += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v -= 1 end
            if hum and hum.MoveDirection.Magnitude > 0.05 and md.Magnitude < 0.05 then md = hum.MoveDirection end
            if md.Magnitude > 1 then md = md.Unit end
            bv.Velocity = (md * Cfg.FlySpeed) + Vector3.new(0, v * Cfg.FlyVertical, 0)
            if c then bg.CFrame = c.CFrame end
        else
            local h2 = char:FindFirstChildOfClass("Humanoid")
            if h2 then h2.PlatformStand = false end
            local bv = hrp:FindFirstChild("BH_Fly"); if bv then bv:Destroy() end
            local bg = hrp:FindFirstChild("BH_Gyro"); if bg then bg:Destroy() end
        end
    end)
    if not ok then logError("Fly: " .. tostring(err)) end
end)

RunService.Stepped:Connect(function()
    local ok, err = pcall(function()
        local char = LP.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if Cfg.Noclip then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if originalCollide[p] == nil then originalCollide[p] = p.CanCollide end
                    p.CanCollide = false
                end
            end
        end
        if hum and not Cfg.Fly then
            hum.WalkSpeed = Cfg.SpeedHack and Cfg.SpeedValue or 16
        end
        if Cfg.JumpBoost and hum and not Cfg.Fly then
            hum.UseJumpPower = true; hum.JumpPower = Cfg.JumpPower
        end
        if Cfg.AutoSprint and hum and hum.MoveDirection.Magnitude > 0 and not Cfg.SpeedHack then
            hum.WalkSpeed = math.max(hum.WalkSpeed, 26)
        end
        if Cfg.ReverseSpeed and hum then
            if UIS:IsKeyDown(Enum.KeyCode.S) then hum.WalkSpeed = 60
            else hum.WalkSpeed = Cfg.SpeedHack and Cfg.SpeedValue or 16 end
        end
        if Cfg.AutoStrafe and hum and hum.MoveDirection.Magnitude > 0 then
            hum.WalkSpeed = math.max(hum.WalkSpeed, 30)
        end
        if hrp then hrp.Anchored = Cfg.FreezeSelf or false end
    end)
    if not ok then logError("Movement: " .. tostring(err)) end
end)

