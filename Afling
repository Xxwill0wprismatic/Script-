local CT = { TOOL_NAME="Clicktp", TOOL_TIP="Hold, release on a surface",
    GLOW_FILL=Color3.fromRGB(0,110,255), GLOW_OUTLINE=Color3.fromRGB(90,180,255),
    GLOW_FILL_TRANSPARENCY=0.5, SLOT_OUTLINE=Color3.fromRGB(0,140,255),
    MIN_GLOW_TIME=0.25, SWIPE_CANCEL_PX=24, FIRST_SLOT=true }
