local FC = { TPOffset=Vector3.new(0,0,0), TPWait=0.05, WeldHoldTime=1.0,
    SpinTorque=1e9, SpinVelocity=5000, SpinPartDensity=2000, SpinPartSize=3,
    SelfSpin=true, SelfSpinHold=1.0, PostFlingOffset=Vector3.new(0,8,0), LoopInterval=1.5 }
local flingCleanups = {}
local function ftrack(i) if i then flingCleanups[i] = true end; return i end
local function funtrack(i) flingCleanups[i] = nil end

local function tpWeldSpin(targetChar)
    if not targetChar or not targetChar.Parent then return false end
    local tHrp = targetChar:FindFirstChild("HumanoidRootPart")
    local tHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not tHrp or not tHum or tHum.Health <= 0 then return false end
    local mChar = LP.Character
    local mHrp = mChar and mChar:FindFirstChild("HumanoidRootPart")
    local mHum = mChar and mChar:FindFirstChildOfClass("Humanoid")
    if not mHrp or not mHum or mHum.Health <= 0 then return false end
    local prev = tHrp:FindFirstChild("FL_SpinWeld"); if prev then pcall(function() prev:Destroy() end) end
    local prevS = mHrp:FindFirstChild("FL_SelfWeld"); if prevS then pcall(function() prevS:Destroy() end) end
    pcall(function() tHrp:SetNetworkOwner(LP) end)
    mHrp.AssemblyLinearVelocity = Vector3.zero
    mHrp.AssemblyAngularVelocity = Vector3.zero
    mHrp.CFrame = tHrp.CFrame * CFrame.new(FC.TPOffset)
    task.wait(FC.TPWait)
    if mHrp.Parent and tHrp.Parent then
        local weld = Instance.new("WeldConstraint")
        weld.Name = "FL_SelfWeld"; weld.Part0 = mHrp; weld.Part1 = tHrp
        weld.Parent = mHrp; ftrack(weld)
        local spin = Instance.new("Part")
        spin.Name = "FL_SpinWeld"
        spin.Size = Vector3.new(FC.SpinPartSize, FC.SpinPartSize, FC.SpinPartSize)
        spin.Transparency = 1; spin.CanCollide = false
        spin.CanQuery = false; spin.CanTouch = false; spin.Massless = false
        spin.CustomPhysicalProperties = PhysicalProperties.new(FC.SpinPartDensity, 0.3, 0.5, 1, 1)
        spin.CFrame = tHrp.CFrame; spin.Parent = Workspace; ftrack(spin)
        local weld2 = Instance.new("WeldConstraint")
        weld2.Part0 = tHrp; weld2.Part1 = spin
        weld2.Parent = spin; ftrack(weld2)
        local bav = Instance.new("BodyAngularVelocity")
        bav.AngularVelocity = Vector3.new(FC.SpinVelocity, FC.SpinVelocity, FC.SpinVelocity)
        bav.MaxTorque = Vector3.new(FC.SpinTorque, FC.SpinTorque, FC.SpinTorque)
        bav.P = 1e9; bav.Parent = tHrp; ftrack(bav)
        local bav2 = Instance.new("BodyAngularVelocity")
        bav2.AngularVelocity = Vector3.new(FC.SpinVelocity, FC.SpinVelocity, FC.SpinVelocity)
        bav2.MaxTorque = Vector3.new(FC.SpinTorque, FC.SpinTorque, FC.SpinTorque)
        bav2.P = 1e9; bav2.Parent = spin; ftrack(bav2)
        local myBav
        if FC.SelfSpin then
            myBav = Instance.new("BodyAngularVelocity")
            myBav.AngularVelocity = Vector3.new(FC.SpinVelocity, FC.SpinVelocity, FC.SpinVelocity)
            myBav.MaxTorque = Vector3.new(FC.SpinTorque, FC.SpinTorque, FC.SpinTorque)
            myBav.P = 1e9; myBav.Parent = mHrp; ftrack(myBav)
        end
        pcall(function() tHum.PlatformStand = true end)
        task.delay(FC.WeldHoldTime, function()
            if weld and weld.Parent then pcall(function() weld:Destroy() end); funtrack(weld) end
            if weld2 and weld2.Parent then pcall(function() weld2:Destroy() end); funtrack(weld2) end
            if bav and bav.Parent then pcall(function() bav:Destroy() end); funtrack(bav) end
            if bav2 and bav2.Parent then pcall(function() bav2:Destroy() end); funtrack(bav2) end
            if spin and spin.Parent then pcall(function() spin:Destroy() end); funtrack(spin) end
            if tHum and tHum.Parent then pcall(function() tHum.PlatformStand = false end) end
        end)
        task.delay(FC.SelfSpinHold, function()
            if myBav and myBav.Parent then pcall(function() myBav:Destroy() end); funtrack(myBav) end
            if mHrp and mHrp.Parent then
                mHrp.AssemblyLinearVelocity = Vector3.zero
                mHrp.CFrame = mHrp.CFrame + FC.PostFlingOffset
            end
        end)
    end
    return true
end
