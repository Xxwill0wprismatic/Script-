RunService.RenderStepped:Connect(function()
    if not Cfg.AimbotEnabled then return end
    local ok, err = pcall(function()
        local c = cam(); if not c then return end
        local cp = c.CFrame.Position
        local best, bd = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and isAlive(plr) and not isSameTeam(plr) then
                local char = plr.Character
                local part = char:FindFirstChild(Cfg.AimPart) or char:FindFirstChild("HumanoidRootPart")
                if part then
                    local d = (part.Position - cp).Magnitude
                    if d <= Cfg.MaxDistance and d < bd and hasLOS(part, char) then
                        local sp = w2s(part.Position)
                        if sp and (sp - scrCenter()).Magnitude <= Cfg.FOV then
                            bd = d; best = { part = part }
                        end
                    end
                end
            end
        end
        if best then
            c.CFrame = CFrame.new(c.CFrame.Position, best.part.Position)
            if Cfg.AutoShoot then
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    local v = c.ViewportSize
                    vim:SendMouseButtonEvent(math.floor(v.X/2), math.floor(v.Y/2), 0, true, game, 0)
                    task.wait(0.01)
                    vim:SendMouseButtonEvent(math.floor(v.X/2), math.floor(v.Y/2), 0, false, game, 0)
                end)
            end
        end
    end)
    if not ok then logError("Aimbot: " .. tostring(err)) end
end)

RunService.RenderStepped:Connect(function()
    local ok, err = pcall(function()
        local char = LP.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp then return end
        if Cfg.Fly then
            if hum then hum.PlatformStand = true end
            local c = cam()
            local bv = hrp:FindFirstChild("BH_Fly")
            local bg = hrp:FindFirstChild("BH_Gyro")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "BH_Fly"; bv.MaxForce = Vector3.new(1e5,1e5,1e5)
                bv.P = 1250; bv.Velocity = Vector3.zero; bv.Parent = hrp
            end
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "BH_Gyro"; bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
                bg.P = 5000; bg.D = 500; bg.Parent = hrp
            end
            local md = Vector3.zero; local v = 0
            if c then
                if UIS:IsKeyDown(Enum.KeyCode.W) then md += c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then md -= c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then md -= c.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then md += c.CFrame.RightVector end
            end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then v += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v -= 1 end
            if hum and hum.MoveDirection.Magnitude > 0.05 and md.Magnitude < 0.05 then md = hum.MoveDirection end
            if md.Magnitude > 1 then md = md.Unit end
            bv.Velocity = (md * Cfg.FlySpeed) + Vector3.new(0, v * Cfg.FlyVertical, 0)
            if c then bg.CFrame = c.CFrame end
        else
            local h2 = char:FindFirstChildOfClass("Humanoid")
            if h2 then h2.PlatformStand = false end
            local bv = hrp:FindFirstChild("BH_Fly"); if bv then bv:Destroy() end
            local bg = hrp:FindFirstChild("BH_Gyro"); if bg then bg:Destroy() end
        end
    end)
    if not ok then logError("Fly: " .. tostring(err)) end
end)

