local dragState, dragStart = nil, nil
local function beginDrag(input)
    dragState = true
    dragStart = { px = input.Position.X, py = input.Position.Y,
                  ax = Main.AbsolutePosition.X, ay = Main.AbsolutePosition.Y }
end
local function updateDrag(input)
    if not dragState or not dragStart then return end
    Main.Position = UDim2.new(0, dragStart.ax + (input.Position.X - dragStart.px),
                              0, dragStart.ay + (input.Position.Y - dragStart.py))
end
local function endDrag() dragState, dragStart = nil, nil end
