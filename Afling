local function ctClear() ClickTP.hovered = nil; if ClickTP.glow then ClickTP.glow.Adornee = nil end end
local function ctCast(ray)
    local filter = { LP.Character }
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    for _ = 1, 8 do
        local r = Workspace:Raycast(ray.Origin, ray.Direction.Unit*3000, params)
        if not r then return nil end
        local p = r.Instance
        if p ~= Workspace.Terrain and p.Transparency >= 0.99 and not p.CanCollide then
            filter[#filter+1] = p; params.FilterDescendantsInstances = filter
        else return r end
    end
    return nil
end
local function ctPos(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        return Vector2.new(i.Position.X, i.Position.Y)
    end
    return UIS:GetMouseLocation()
end
local function ctRay(i)
    local c = cam(); if not c then return nil end
    local p = ctPos(i)
    if i.UserInputType == Enum.UserInputType.Touch then return c:ScreenPointToRay(p.X, p.Y) end
    return c:ViewportPointToRay(p.X, p.Y)
end
local function ctHover()
    local ray = ClickTP.active and ctRay(ClickTP.active)
    local r = ray and ctCast(ray)
    if r then
        if ClickTP.glow.Adornee ~= r.Instance then
            ClickTP.glow.Adornee = r.Instance; ClickTP.shownAt = os.clock()
        end
        ClickTP.hovered = r
    else ctClear() end
end
local function ctTP(res)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end
    local lift = 3
    if hum and hum.RigType == Enum.HumanoidRigType.R15 then
        lift = hum.HipHeight + hrp.Size.Y/2
    end
    lift = lift + 0.3
    local n, p = res.Normal, res.Position
    local up = Vector3.new(0,1,0)
    local flat = Vector3.new(n.X, 0, n.Z)
    local target
    if n.Y > 0.6 then target = p + flat*1.5 + up*lift
    elseif n.Y < -0.6 then target = p + n*3.5
    else
        local mag = flat.Magnitude
        if mag < 0.001 then return end
        target = p + (flat/mag)*2 + up*lift
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(target) * (hrp.CFrame - hrp.CFrame.Position)
end
local function ctAbort()
    ClickTP.active = nil
    if ClickTP.stepConn then ClickTP.stepConn:Disconnect(); ClickTP.stepConn = nil end
    ctClear()
end
local function ctFinish()
    if not ClickTP.active then return end
    local target = ClickTP.hovered
    local cx = ClickTP.cancelled
    ClickTP.active = nil
    if ClickTP.stepConn then ClickTP.stepConn:Disconnect(); ClickTP.stepConn = nil end
    if cx or not target then ctClear(); return end
    ClickTP.busy = true
    task.spawn(function()
        local rem = CT.MIN_GLOW_TIME - (os.clock() - ClickTP.shownAt)
        if rem > 0 then task.wait(rem) end
        if ClickTP.enabled and ClickTP.equipped then pcall(ctTP, target) end
        ctClear(); ClickTP.busy = false
    end)
end
local function ctStep()
    if not ClickTP.active then return end
    if ClickTP.active.UserInputType == Enum.UserInputType.Touch then
        local st = ClickTP.active.UserInputState
        if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
            ctFinish(); return
        end
        if not ClickTP.cancelled
        and (ctPos(ClickTP.active) - ClickTP.startPos).Magnitude > CT.SWIPE_CANCEL_PX then
            ClickTP.cancelled = true; ctClear()
        end
    end
    if not ClickTP.cancelled then ctHover() end
end
UIS.InputBegan:Connect(function(i, gp)
    if gp or not ClickTP.enabled or not ClickTP.equipped or ClickTP.busy or ClickTP.active then return end
    local t = i.UserInputType
    if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
    ClickTP.active = i; ClickTP.cancelled = false
    ClickTP.startPos = ctPos(i); ClickTP.shownAt = os.clock()
    ctHover()
    ClickTP.stepConn = RunService.RenderStepped:Connect(ctStep)
end)
UIS.InputEnded:Connect(function(i)
    if not ClickTP.active then return end
    if i == ClickTP.active
    or (ClickTP.active.UserInputType == Enum.UserInputType.MouseButton1
    and i.UserInputType == Enum.UserInputType.MouseButton1) then
        ctFinish()
    end
end)
local function ctFindSlot()
