local resizeState = nil
local function beginResize(mode, input)
    resizeState = { mode=mode, sx=input.Position.X, sy=input.Position.Y,
                    w=Main.AbsoluteSize.X, h=Main.AbsoluteSize.Y }
end
local function updateResize(input)
    if not resizeState then return end
    local dx = input.Position.X - resizeState.sx
    local dy = input.Position.Y - resizeState.sy
    local nW, nH = resizeState.w, resizeState.h
    if resizeState.mode == "r" or resizeState.mode == "br" then
        nW = math.clamp(resizeState.w + dx, MIN_W, MAX_W)
    end
    if resizeState.mode == "b" or resizeState.mode == "br" then
        nH = math.clamp(resizeState.h + dy, MIN_H, MAX_H)
    end
    Main.Size = UDim2.new(0, nW, 0, nH)
end
local function endResize() resizeState = nil end

