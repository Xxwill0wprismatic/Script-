local loopOn = false
local loopThread = nil
local loopBtn
local function setLoop()
    if not loopBtn then return end
    if loopOn then
        loopBtn.BackgroundColor3 = PURPLE_DARK
        loopBtn.TextColor3 = PURPLE_LIGHT
        loopBtn.Text = "LOOP FLING ALL: ON"
    else
        loopBtn.BackgroundColor3 = BLACK
        loopBtn.TextColor3 = Color3.fromRGB(220,220,220)
        loopBtn.Text = "LOOP FLING ALL: OFF"
    end
end
local function stopLoop()
    loopOn = false
    if loopThread then task.cancel(loopThread); loopThread = nil end
    setLoop()
end
local function startLoop()
    loopOn = true; setLoop()
    loopThread = task.spawn(function()
        while loopOn and sg.Parent do
            for _, plr in ipairs(Players:GetPlayers()) do
                if not loopOn then break end
                if plr ~= LP then pcall(flingPlayer, plr); task.wait(0.25) end
            end
            task.wait(FC.LoopInterval)
        end
        loopOn = false; setLoop()
    end)
end
